<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner: a console app with its own tiny assert helpers (TestKit.cs).
    See tests\README.md for how to run it. Exit code = number of failed tests.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartNotes.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SmartNotes.csproj" />
  </ItemGroup>

</Project>

<!--
    Ink & Washi menus: a slip of rice paper, ink-black EB Garamond, a faint vermilion wash for the selection and the
    seal's red for chosen options. Tokens only; templates in SkinMenuBase.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SkinMenuBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Panel -->
    <LinearGradientBrush x:Key="MenuPanelBgBrush" StartPoint="0,0" EndPoint="0.3,1" po:Freeze="True">
        <GradientStop Color="#F8F4EA" Offset="0"/>
        <GradientStop Color="#EFE8D8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuShadowBrush" Color="#EFE8D8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#40201C18" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelInnerFrameBrush" Color="Transparent" po:Freeze="True"/>
    <CornerRadius x:Key="MenuPanelRadius">2</CornerRadius>
    <Thickness x:Key="MenuPanelPadding">6</Thickness>

    <!-- Rows -->
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#1F1B17" po:Freeze="True"/>
    <FontFamily x:Key="MenuItemFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <FontWeight x:Key="MenuItemFontWeight">Medium</FontWeight>
    <sys:Double x:Key="MenuItemFontSize">15</sys:Double>
    <CornerRadius x:Key="MenuItemRadius">2</CornerRadius>
    <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#1FC23B22" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItemHighlightEdgeBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuIconBrush" Color="#5E574C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#B3261E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuAccentBrush" Color="#C23B22" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuOnAccentBrush" Color="#F8F4EA" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#26201C18" po:Freeze="True"/>
    <sys:Double x:Key="MenuToolTipFontSize">14</sys:Double>

    <!-- Popup text -->
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#8A8172" po:Freeze="True"/>
    <FontFamily x:Key="MenuHeaderFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <sys:Double x:Key="MenuHeaderFontSize">13</sys:Double>
    <SolidColorBrush x:Key="MenuLabelBrush" Color="#1F1B17" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelMutedBrush" Color="#8A8172" po:Freeze="True"/>
    <FontFamily x:Key="MenuLabelFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <sys:Double x:Key="MenuLabelFontSize">14.5</sys:Double>

    <!-- Popup controls -->
    <SolidColorBrush x:Key="MenuChoiceBgBrush" Color="#0A1F1B17" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceTextBrush" Color="#1F1B17" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceIdleBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBrush" Color="#C23B22" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBgBrush" Color="#C23B22" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedTextBrush" Color="#F8F4EA" po:Freeze="True"/>
    <CornerRadius x:Key="MenuChoiceRadius">2</CornerRadius>
    <SolidColorBrush x:Key="MenuSliderTrackBrush" Color="#22201C18" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderFillBrush" Color="#1F1B17" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBrush" Color="#F8F4EA" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBorderBrush" Color="#1F1B17" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchTrackBrush" Color="#E6DDC8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchBorderBrush" Color="#44201C18" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#8A8172" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnTrackBrush" Color="#C23B22" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#F8F4EA" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBgBrush" Color="#FBF8F1" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBorderBrush" Color="#33201C18" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputTextBrush" Color="#1F1B17" po:Freeze="True"/>
</ResourceDictionary>

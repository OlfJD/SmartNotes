<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SmartNotes.UI.Controls">
    
    <!-- Neon Yellow/Green Futuristic Brushes -->
    <SolidColorBrush x:Key="NeonYellow" Color="#DFFF00"/>
    <SolidColorBrush x:Key="DarkBg" Color="#0B0D05"/>
    <SolidColorBrush x:Key="PanelBg" Color="#161A0A"/>
    <SolidColorBrush x:Key="MutedYellow" Color="#44DFFF00"/>
    <SolidColorBrush x:Key="DimYellow" Color="#22DFFF00"/>
    
    <!-- Grid Background -->
    <DrawingBrush x:Key="GridBg" Viewport="0,0,40,40" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource DimYellow}" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Caution Stripes -->
    <DrawingBrush x:Key="CautionStripes" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Transform>
            <RotateTransform Angle="45" />
        </DrawingBrush.Transform>
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,10,20"/>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Brush>
                    <SolidColorBrush Color="#DFFF00"/>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Icon Button Style for Cyberpunk -->
    <Style x:Key="CyberIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MutedYellow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="StickyNoteTemplate" TargetType="Window">
        <Grid>
            <!-- Background with Grid -->
            <Border Background="{StaticResource DarkBg}" BorderBrush="{StaticResource NeonYellow}" BorderThickness="3">
                <Border Background="{StaticResource GridBg}" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>

                        <!-- Futuristic Header -->
                        <Grid Grid.Row="0" Margin="10,10,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left controls -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PART_BtnNewNote" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon x:Name="PART_IconPlus" IconKey="plus" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                <Button x:Name="PART_BtnPinMode" Style="{StaticResource CyberIconButton}" Width="30" Height="30" Margin="5,0,0,0">
                                    <controls:LucideIcon x:Name="PART_IconPin" IconKey="pin" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                            </StackPanel>

                            <!-- Center Decorative Bar -->
                            <Border Grid.Column="1" Height="2" Background="{StaticResource NeonYellow}" Margin="15,0,15,0" VerticalAlignment="Center"/>

                            <!-- Right Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="PART_BtnTextMode" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon x:Name="PART_IconTextMode" IconKey="file-text" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                <Button x:Name="PART_BtnChecklistMode" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon x:Name="PART_IconChecklistMode" IconKey="list-todo" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                <Button x:Name="PART_BtnCopyMode" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon x:Name="PART_IconCopyMode" IconKey="copy" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                
                                <Border Width="2" Background="{StaticResource NeonYellow}" Margin="5,5,5,5"/>

                                <Button x:Name="PART_BtnColorPicker" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon IconKey="palette" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                <Button x:Name="PART_BtnLock" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon x:Name="PART_IconLock" IconKey="unlock" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                <Button x:Name="PART_BtnMore" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon IconKey="more-horizontal" Size="16" Foreground="{StaticResource NeonYellow}"/>
                                </Button>
                                <Button x:Name="PART_BtnClose" Style="{StaticResource CyberIconButton}" Width="30" Height="30">
                                    <controls:LucideIcon IconKey="x" Size="18" StrokeThickness="3" Foreground="Red"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Title -->
                        <Grid Grid.Row="1" Margin="10,10,10,0">
                            <TextBox x:Name="PART_TxtTitle" Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeonYellow}" FontSize="18" FontFamily="Consolas, Courier New, monospace" FontWeight="Bold" CaretBrush="{StaticResource NeonYellow}"/>
                            <TextBlock x:Name="PART_TxtTitlePlaceholder" Text="TITLE_INPUT..." Foreground="{StaticResource MutedYellow}" FontSize="18" FontFamily="Consolas, Courier New, monospace" FontWeight="Bold" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Body Containers -->
                        <Border Grid.Row="2" Margin="10,10,10,10" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource NeonYellow}" BorderThickness="1">
                            <Grid Margin="10">
                                <!-- Text Mode -->
                                <Grid x:Name="PART_TextModeContainer" Visibility="Visible">
                                    <TextBox x:Name="PART_TxtContent" Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeonYellow}" FontSize="14" FontFamily="Consolas, Courier New, monospace" AcceptsReturn="True" TextWrapping="Wrap" CaretBrush="{StaticResource NeonYellow}"/>
                                    <TextBlock x:Name="PART_TxtContentPlaceholder" Text="> AWAITING INPUT..." Foreground="{StaticResource MutedYellow}" FontSize="14" FontFamily="Consolas, Courier New, monospace" IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Checklist Mode -->
                                <Grid x:Name="PART_ChecklistModeContainer" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PART_ChecklistItemsControl" ItemTemplate="{DynamicResource ChecklistItemTemplate}"/>
                                    </ScrollViewer>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource NeonYellow}" BorderThickness="1" Padding="5" Margin="0,5,0,0">
                                        <Grid>
                                            <TextBox x:Name="PART_TxtNewTask" Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeonYellow}" FontSize="14" FontFamily="Consolas, Courier New, monospace" CaretBrush="{StaticResource NeonYellow}"/>
                                            <TextBlock x:Name="PART_TxtNewTaskPlaceholder" Text="> ADD_TASK..." Foreground="{StaticResource MutedYellow}" FontSize="14" FontFamily="Consolas, Courier New, monospace" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Copy Mode -->
                                <Grid x:Name="PART_CopyModeContainer" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PART_CopyItemsControl" ItemTemplate="{DynamicResource CopySnippetItemTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Caution Stripe Decoration Bottom Right -->
                        <Border Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="60" Height="15" Background="{StaticResource CautionStripes}" Margin="0,0,10,10"/>
                        <!-- Decorative cut corner simulation -->
                        <Polygon Grid.Row="2" Grid.RowSpan="2" Points="0,20 20,0 20,20" Fill="{StaticResource DarkBg}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>

                    </Grid>
                </Border>
            </Border>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>

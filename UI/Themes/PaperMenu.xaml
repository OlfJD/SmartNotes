<!--
    Paper Sticky menus (proposal 3 on docs/references/themed-menus-board.html).
    A light sticky note with a yellow glue strip, soft yellow selection, dark ink, Segoe UI.
    Tokens only; the templates are in SkinMenuBase.xaml (see UI/Controls/SkinMenus.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SkinMenuBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Panel -->
    <SolidColorBrush x:Key="MenuPanelBgBrush" Color="#FFF8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuShadowBrush" Color="#FFF8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#1A2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelInnerFrameBrush" Color="Transparent" po:Freeze="True"/>
    <CornerRadius x:Key="MenuPanelRadius">3</CornerRadius>
    <Thickness x:Key="MenuPanelPadding">5</Thickness>
    <sys:Double x:Key="MenuTopStripHeight">10</sys:Double>
    <SolidColorBrush x:Key="MenuTopStripBrush" Color="#F6DD8A" po:Freeze="True"/>
    <CornerRadius x:Key="MenuTopStripRadius">3,3,0,0</CornerRadius>

    <!-- Rows -->
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#2A2415" po:Freeze="True"/>
    <FontFamily x:Key="MenuItemFont">Segoe UI</FontFamily>
    <FontWeight x:Key="MenuItemFontWeight">Normal</FontWeight>
    <sys:Double x:Key="MenuItemFontSize">13.5</sys:Double>
    <CornerRadius x:Key="MenuItemRadius">4</CornerRadius>
    <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#F5E6A8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItemHighlightEdgeBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#1A160C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuIconBrush" Color="#6B624E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#B42318" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuAccentBrush" Color="#2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuOnAccentBrush" Color="#FFF8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#222A2415" po:Freeze="True"/>
    <sys:Double x:Key="MenuToolTipFontSize">12.5</sys:Double>

    <!-- Popup text -->
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#7A715C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelBrush" Color="#2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelMutedBrush" Color="#7A715C" po:Freeze="True"/>

    <!-- Popup controls -->
    <SolidColorBrush x:Key="MenuChoiceBgBrush" Color="#0A000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceTextBrush" Color="#2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceIdleBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBrush" Color="#E2C25E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBgBrush" Color="#F6DD8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedTextBrush" Color="#1A160C" po:Freeze="True"/>
    <CornerRadius x:Key="MenuChoiceRadius">4</CornerRadius>
    <SolidColorBrush x:Key="MenuSliderTrackBrush" Color="#222A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderFillBrush" Color="#2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBrush" Color="#FFF8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBorderBrush" Color="#2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchTrackBrush" Color="#EFE6C8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchBorderBrush" Color="#442A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#7A715C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnTrackBrush" Color="#2A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#FFF8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBgBrush" Color="#FFFDF2" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBorderBrush" Color="#332A2415" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputTextBrush" Color="#2A2415" po:Freeze="True"/>
</ResourceDictionary>

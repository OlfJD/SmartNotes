<!--
    Astral menus (proposal 4 on docs/references/themed-menus-board.html).
    Night-sky panel with a few stars, silver double frame, pale-blue selection band, Cinzel headings, EB Garamond rows.
    Tokens only; the templates are in SkinMenuBase.xaml (see UI/Controls/SkinMenus.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SkinMenuBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Panel: night gradient with scattered stars (viewbox 0..100, stretched to the panel) -->
    <DrawingBrush x:Key="MenuPanelBgBrush" Stretch="Fill" po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#141A2E" Offset="0"/>
                            <GradientStop Color="#0B0E1A" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#99FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="20,30" RadiusX="0.35" RadiusY="0.22"/>
                            <EllipseGeometry Center="70,12" RadiusX="0.3" RadiusY="0.2"/>
                            <EllipseGeometry Center="40,80" RadiusX="0.3" RadiusY="0.2"/>
                            <EllipseGeometry Center="92,38" RadiusX="0.28" RadiusY="0.18"/>
                            <EllipseGeometry Center="8,62" RadiusX="0.3" RadiusY="0.2"/>
                            <EllipseGeometry Center="55,48" RadiusX="0.22" RadiusY="0.14"/>
                            <EllipseGeometry Center="30,6" RadiusX="0.25" RadiusY="0.16"/>
                            <EllipseGeometry Center="64,94" RadiusX="0.28" RadiusY="0.18"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#CCCFE0FF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="85,60" RadiusX="0.5" RadiusY="0.32"/>
                            <EllipseGeometry Center="14,90" RadiusX="0.45" RadiusY="0.28"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="MenuShadowBrush" Color="#0B0E1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#AAA9B8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelInnerFrameBrush" Color="#44A9B8E0" po:Freeze="True"/>
    <CornerRadius x:Key="MenuPanelRadius">0</CornerRadius>
    <Thickness x:Key="MenuPanelPadding">7</Thickness>

    <!-- Rows -->
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#DFE4F2" po:Freeze="True"/>
    <FontFamily x:Key="MenuItemFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <FontWeight x:Key="MenuItemFontWeight">Medium</FontWeight>
    <sys:Double x:Key="MenuItemFontSize">14.5</sys:Double>
    <CornerRadius x:Key="MenuItemRadius">0</CornerRadius>
    <LinearGradientBrush x:Key="MenuItemHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00A9C4FF" Offset="0"/>
        <GradientStop Color="#26A9C4FF" Offset="0.2"/>
        <GradientStop Color="#26A9C4FF" Offset="0.8"/>
        <GradientStop Color="#00A9C4FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuItemHighlightEdgeBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00CFE0FF" Offset="0"/>
        <GradientStop Color="#55CFE0FF" Offset="0.2"/>
        <GradientStop Color="#55CFE0FF" Offset="0.8"/>
        <GradientStop Color="#00CFE0FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuIconBrush" Color="#A9B8E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#E07A8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuAccentBrush" Color="#A9C4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuOnAccentBrush" Color="#0B0E1A" po:Freeze="True"/>
    <LinearGradientBrush x:Key="MenuSeparatorBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00A9B8E0" Offset="0"/>
        <GradientStop Color="#88A9B8E0" Offset="0.5"/>
        <GradientStop Color="#00A9B8E0" Offset="1"/>
    </LinearGradientBrush>
    <sys:Double x:Key="MenuToolTipFontSize">13.5</sys:Double>

    <!-- Popup text -->
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#B9C8F0" po:Freeze="True"/>
    <FontFamily x:Key="MenuHeaderFont">pack://application:,,,/Assets/Fonts/#Cinzel, Palatino Linotype, Georgia</FontFamily>
    <sys:Double x:Key="MenuHeaderFontSize">11.5</sys:Double>
    <SolidColorBrush x:Key="MenuLabelBrush" Color="#DFE4F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelMutedBrush" Color="#8A93AD" po:Freeze="True"/>
    <FontFamily x:Key="MenuLabelFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <sys:Double x:Key="MenuLabelFontSize">14</sys:Double>

    <!-- Popup controls -->
    <SolidColorBrush x:Key="MenuChoiceBgBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceTextBrush" Color="#CFD6EA" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceIdleBrush" Color="#3A4568" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBrush" Color="#CFE0FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBgBrush" Color="#1AA9C4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedTextBrush" Color="#FFFFFF" po:Freeze="True"/>
    <FontFamily x:Key="MenuChoiceFont">pack://application:,,,/Assets/Fonts/#Cinzel, Palatino Linotype, Georgia</FontFamily>
    <CornerRadius x:Key="MenuChoiceRadius">0</CornerRadius>
    <SolidColorBrush x:Key="MenuSliderTrackBrush" Color="#2A3350" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderFillBrush" Color="#A9C4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBorderBrush" Color="#A9C4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchTrackBrush" Color="#0E1222" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchBorderBrush" Color="#3A4568" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#8A93AD" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnTrackBrush" Color="#2A3A66" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#CFE0FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBgBrush" Color="#0E1222" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBorderBrush" Color="#3A4568" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputTextBrush" Color="#DFE4F2" po:Freeze="True"/>
</ResourceDictionary>

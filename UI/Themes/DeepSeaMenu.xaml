<!--
    Deep Sea menus: dark water darkening downward, a thin luminous rim, a soft cyan glow band for the selection,
    Audiowide headings. Tokens only; templates in SkinMenuBase.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SkinMenuBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Panel -->
    <LinearGradientBrush x:Key="MenuPanelBgBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#0D3240" Offset="0"/>
        <GradientStop Color="#061A24" Offset="0.5"/>
        <GradientStop Color="#020A10" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuShadowBrush" Color="#020A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#AA5FD4DE" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelInnerFrameBrush" Color="Transparent" po:Freeze="True"/>
    <CornerRadius x:Key="MenuPanelRadius">10</CornerRadius>
    <Thickness x:Key="MenuPanelPadding">6</Thickness>

    <!-- Rows -->
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#DDF4F5" po:Freeze="True"/>
    <FontFamily x:Key="MenuItemFont">Segoe UI</FontFamily>
    <FontWeight x:Key="MenuItemFontWeight">Normal</FontWeight>
    <sys:Double x:Key="MenuItemFontSize">13.5</sys:Double>
    <CornerRadius x:Key="MenuItemRadius">7</CornerRadius>
    <LinearGradientBrush x:Key="MenuItemHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#0A7FE7FF" Offset="0"/>
        <GradientStop Color="#307FE7FF" Offset="0.5"/>
        <GradientStop Color="#0A7FE7FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuItemHighlightEdgeBrush" Color="#447FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuIconBrush" Color="#7FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#FF8A9A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuAccentBrush" Color="#7FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuOnAccentBrush" Color="#021018" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#445FD4DE" po:Freeze="True"/>
    <sys:Double x:Key="MenuToolTipFontSize">12.5</sys:Double>

    <!-- Popup text -->
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#8FE3EC" po:Freeze="True"/>
    <FontFamily x:Key="MenuHeaderFont">pack://application:,,,/Assets/Fonts/#Audiowide, Segoe UI</FontFamily>
    <sys:Double x:Key="MenuHeaderFontSize">11</sys:Double>
    <SolidColorBrush x:Key="MenuLabelBrush" Color="#DDF4F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelMutedBrush" Color="#86AEB8" po:Freeze="True"/>

    <!-- Popup controls -->
    <SolidColorBrush x:Key="MenuChoiceBgBrush" Color="#14000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceTextBrush" Color="#CDEFF2" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceIdleBrush" Color="#2A5A66" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBrush" Color="#7FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBgBrush" Color="#267FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedTextBrush" Color="#FFFFFF" po:Freeze="True"/>
    <CornerRadius x:Key="MenuChoiceRadius">7</CornerRadius>
    <SolidColorBrush x:Key="MenuSliderTrackBrush" Color="#0B2A36" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderFillBrush" Color="#7FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBrush" Color="#DDF4F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBorderBrush" Color="#7FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchTrackBrush" Color="#06161E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchBorderBrush" Color="#2A5A66" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#86AEB8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnTrackBrush" Color="#11505E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#7FE7FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBgBrush" Color="#06161E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBorderBrush" Color="#2A5A66" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputTextBrush" Color="#DDF4F5" po:Freeze="True"/>
</ResourceDictionary>

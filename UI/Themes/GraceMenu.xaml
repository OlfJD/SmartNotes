<!--
    Elden Ring: "Grace menu" (option A on docs/references/themed-menus-board.html).
    Olive-black panel, pale-gold double frame with diamond tips, golden selection band, Cinzel headings, EB Garamond rows.
    Tokens only; the templates are in SkinMenuBase.xaml (see UI/Controls/SkinMenus.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SkinMenuBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Panel -->
    <LinearGradientBrush x:Key="MenuPanelBgBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#24251C" Offset="0"/>
        <GradientStop Color="#191A13" Offset="0.6"/>
        <GradientStop Color="#121309" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuShadowBrush" Color="#121309" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#8E8665" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelInnerFrameBrush" Color="#668E8665" po:Freeze="True"/>
    <CornerRadius x:Key="MenuPanelRadius">0</CornerRadius>
    <Thickness x:Key="MenuPanelPadding">7</Thickness>
    <Visibility x:Key="MenuOrnamentVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="MenuOrnamentBrush" Color="#B49A5C" po:Freeze="True"/>

    <!-- Rows -->
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#DDD6C0" po:Freeze="True"/>
    <FontFamily x:Key="MenuItemFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <FontWeight x:Key="MenuItemFontWeight">Medium</FontWeight>
    <sys:Double x:Key="MenuItemFontSize">14.5</sys:Double>
    <CornerRadius x:Key="MenuItemRadius">0</CornerRadius>
    <LinearGradientBrush x:Key="MenuItemHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00F4A23A" Offset="0"/>
        <GradientStop Color="#33F4A23A" Offset="0.2"/>
        <GradientStop Color="#33F4A23A" Offset="0.8"/>
        <GradientStop Color="#00F4A23A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuItemHighlightEdgeBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00F4A23A" Offset="0"/>
        <GradientStop Color="#66F4A23A" Offset="0.2"/>
        <GradientStop Color="#66F4A23A" Offset="0.8"/>
        <GradientStop Color="#00F4A23A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#FFF3D6" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuIconBrush" Color="#B4A57A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#D06A52" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuAccentBrush" Color="#F4A23A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuOnAccentBrush" Color="#1B1C15" po:Freeze="True"/>
    <LinearGradientBrush x:Key="MenuSeparatorBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#008E8665" Offset="0"/>
        <GradientStop Color="#AA8E8665" Offset="0.5"/>
        <GradientStop Color="#008E8665" Offset="1"/>
    </LinearGradientBrush>
    <sys:Double x:Key="MenuToolTipFontSize">13.5</sys:Double>

    <!-- Popup text -->
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#C9B783" po:Freeze="True"/>
    <FontFamily x:Key="MenuHeaderFont">pack://application:,,,/Assets/Fonts/#Cinzel, Palatino Linotype, Georgia</FontFamily>
    <sys:Double x:Key="MenuHeaderFontSize">11.5</sys:Double>
    <SolidColorBrush x:Key="MenuLabelBrush" Color="#DDD6C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelMutedBrush" Color="#9A927A" po:Freeze="True"/>
    <FontFamily x:Key="MenuLabelFont">pack://application:,,,/Assets/Fonts/#EB Garamond, Palatino Linotype, Georgia</FontFamily>
    <sys:Double x:Key="MenuLabelFontSize">14</sys:Double>

    <!-- Popup controls -->
    <SolidColorBrush x:Key="MenuChoiceBgBrush" Color="#33000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceTextBrush" Color="#CFC6A8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceIdleBrush" Color="#5C573F" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBrush" Color="#F4A23A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBgBrush" Color="#33000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedTextBrush" Color="#FFE6B0" po:Freeze="True"/>
    <FontFamily x:Key="MenuChoiceFont">pack://application:,,,/Assets/Fonts/#Cinzel, Palatino Linotype, Georgia</FontFamily>
    <CornerRadius x:Key="MenuChoiceRadius">0</CornerRadius>
    <SolidColorBrush x:Key="MenuTileIdleBrush" Color="#4A4634" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderTrackBrush" Color="#2A2B21" po:Freeze="True"/>
    <LinearGradientBrush x:Key="MenuSliderFillBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#8E6A2A" Offset="0"/>
        <GradientStop Color="#F4A23A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuSliderThumbBrush" Color="#F4A23A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBorderBrush" Color="#FFE6B0" po:Freeze="True"/>
    <Visibility x:Key="MenuSliderRoundVisibility">Collapsed</Visibility>
    <Visibility x:Key="MenuSliderDiamondVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="MenuSwitchTrackBrush" Color="#1B1C15" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchBorderBrush" Color="#5C573F" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#9A927A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnTrackBrush" Color="#3A2E17" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#F4A23A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBgBrush" Color="#0F100B" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBorderBrush" Color="#5C573F" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputTextBrush" Color="#DDD6C0" po:Freeze="True"/>
</ResourceDictionary>

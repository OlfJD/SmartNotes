<!--
    Medieval menus (proposal 2 on docs/references/themed-menus-board.html).
    Parchment panel with an ink double frame, oxblood selection, IM Fell English throughout.
    Tokens only; the templates are in SkinMenuBase.xaml (see UI/Controls/SkinMenus.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SkinMenuBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Panel -->
    <RadialGradientBrush x:Key="MenuPanelBgBrush" Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.75" RadiusY="0.8" po:Freeze="True">
        <GradientStop Color="#ECDCB0" Offset="0"/>
        <GradientStop Color="#DCC690" Offset="0.65"/>
        <GradientStop Color="#B99A5E" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="MenuShadowBrush" Color="#B99A5E" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelBorderBrush" Color="#4A3620" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuPanelInnerFrameBrush" Color="#884A3620" po:Freeze="True"/>
    <CornerRadius x:Key="MenuPanelRadius">2</CornerRadius>
    <Thickness x:Key="MenuPanelPadding">7</Thickness>

    <!-- Rows -->
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#2A1B0C" po:Freeze="True"/>
    <FontFamily x:Key="MenuItemFont">pack://application:,,,/Assets/Fonts/#IM FELL English, Georgia</FontFamily>
    <FontWeight x:Key="MenuItemFontWeight">Normal</FontWeight>
    <sys:Double x:Key="MenuItemFontSize">15</sys:Double>
    <CornerRadius x:Key="MenuItemRadius">0</CornerRadius>
    <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#1E5A1A10" po:Freeze="True"/>
    <LinearGradientBrush x:Key="MenuItemHighlightEdgeBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#005A1A10" Offset="0"/>
        <GradientStop Color="#665A1A10" Offset="0.2"/>
        <GradientStop Color="#665A1A10" Offset="0.8"/>
        <GradientStop Color="#005A1A10" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuItemHighlightTextBrush" Color="#5A1A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuIconBrush" Color="#6B4A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuDangerBrush" Color="#9B1C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuAccentBrush" Color="#5A1A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuOnAccentBrush" Color="#F3E6C4" po:Freeze="True"/>
    <LinearGradientBrush x:Key="MenuSeparatorBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#004A3620" Offset="0"/>
        <GradientStop Color="#994A3620" Offset="0.5"/>
        <GradientStop Color="#004A3620" Offset="1"/>
    </LinearGradientBrush>
    <sys:Double x:Key="MenuToolTipFontSize">14</sys:Double>

    <!-- Popup text -->
    <SolidColorBrush x:Key="MenuHeaderBrush" Color="#5A1A10" po:Freeze="True"/>
    <FontFamily x:Key="MenuHeaderFont">pack://application:,,,/Assets/Fonts/#IM FELL English, Georgia</FontFamily>
    <sys:Double x:Key="MenuHeaderFontSize">13</sys:Double>
    <SolidColorBrush x:Key="MenuLabelBrush" Color="#2A1B0C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuLabelMutedBrush" Color="#6B5A3C" po:Freeze="True"/>
    <FontFamily x:Key="MenuLabelFont">pack://application:,,,/Assets/Fonts/#IM FELL English, Georgia</FontFamily>
    <sys:Double x:Key="MenuLabelFontSize">13.5</sys:Double>

    <!-- Popup controls -->
    <SolidColorBrush x:Key="MenuChoiceBgBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceTextBrush" Color="#3A2A14" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceIdleBrush" Color="#664A3620" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBrush" Color="#5A1A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedBgBrush" Color="#145A1A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuChoiceSelectedTextBrush" Color="#5A1A10" po:Freeze="True"/>
    <FontFamily x:Key="MenuChoiceFont">pack://application:,,,/Assets/Fonts/#IM FELL English, Georgia</FontFamily>
    <CornerRadius x:Key="MenuChoiceRadius">2</CornerRadius>
    <SolidColorBrush x:Key="MenuSliderTrackBrush" Color="#554A3620" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderFillBrush" Color="#6B4A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBrush" Color="#8A2A18" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSliderThumbBorderBrush" Color="#E3D2A3" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchTrackBrush" Color="#E3D2A3" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchBorderBrush" Color="#4A3620" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchThumbBrush" Color="#6B5A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnTrackBrush" Color="#6B4A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSwitchOnThumbBrush" Color="#F3E6C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBgBrush" Color="#F3E6C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputBorderBrush" Color="#4A3620" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuInputTextBrush" Color="#2A1B0C" po:Freeze="True"/>
</ResourceDictionary>

<Window x:Class="SmartNotes.UI.Windows.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        Title="SmartNotes"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="12">
        <!-- Outer Drop Shadow -->
        <Border Background="#141926" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Main Window Container -->
        <Border Background="#141926"
                BorderBrush="#334368"
                BorderThickness="2"
                CornerRadius="14"
                RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Bar (Draggable) -->
                <Border Grid.Row="0"
                        Background="#10141F"
                        CornerRadius="12,12,0,0"
                        BorderBrush="#1E273C"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Icon -->
                        <controls:LucideIcon x:Name="HeaderIcon" Grid.Column="0" IconKey="zap" Size="14" StrokeThickness="2.2" Foreground="{StaticResource NeonAmberGlowBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Header Title -->
                        <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="SmartNotes" FontSize="12.5" FontWeight="Bold" Foreground="#8898B4" VerticalAlignment="Center"/>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Click="BtnClose_Click" Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A3752"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A2234"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.2" Foreground="#8898B4"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="20,18,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Large Icon Badge -->
                    <Border Grid.Column="0"
                            x:Name="IconBadge"
                            Width="44"
                            Height="44"
                            CornerRadius="12"
                            Background="#1E273C"
                            BorderBrush="#334368"
                            BorderThickness="1.5"
                            VerticalAlignment="Top"
                            Margin="0,2,16,0">
                        <controls:LucideIcon x:Name="MainIcon" IconKey="sparkles" Size="22" StrokeThickness="2.0" Foreground="{StaticResource NeonAmberGlowBrush}"/>
                    </Border>

                    <!-- Message Body -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeading" Text="Heading Text" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtMessage" Text="Message description text goes here." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/>
                    </StackPanel>
                </Grid>

                <!-- Button Bar -->
                <Border Grid.Row="2"
                        Background="#0F131D"
                        CornerRadius="0,0,12,12"
                        BorderBrush="#1E273C"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Secondary Button (Cancel / No / Later) -->
                        <Button x:Name="BtnSecondary"
                                Click="BtnSecondary_Click"
                                Content="Cancel"
                                MinWidth="84"
                                Height="34"
                                Margin="0,0,10,0"
                                Foreground="#CBD5E1"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" Background="#1A2234" BorderBrush="#2D3B59" BorderThickness="1.5" CornerRadius="8" Padding="12,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#25324E"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4C618F"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#131824"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Primary Button (OK / Yes / Got It) -->
                        <Button x:Name="BtnPrimary"
                                Click="BtnPrimary_Click"
                                Content="OK"
                                MinWidth="92"
                                Height="34"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

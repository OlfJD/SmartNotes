<Window x:Class="SmartNotes.UI.Windows.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        xmlns:skins="clr-namespace:SmartNotes.UI.Skins"
        Title="SmartNotes"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <!-- Every colour and font is a Menu* token: the app's look by default (DarkTheme.xaml), the note theme's look
         when a note shows the message (SkinMenus.ApplyToPanel). -->
    <Grid Margin="12">
        <skins:CutBorder Background="{DynamicResource MenuShadowBrush}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}">
            <skins:CutBorder.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
            </skins:CutBorder.Effect>
        </skins:CutBorder>

        <skins:CutBorder Background="{DynamicResource MenuPanelBgBrush}" BorderBrush="{DynamicResource MenuPanelBorderBrush}" BorderThickness="{DynamicResource MenuPanelBorderThickness}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}" RenderOptions.ClearTypeHint="Enabled">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="{DynamicResource MenuTopStripHeight}" Background="{DynamicResource MenuTopStripBrush}" CornerRadius="{DynamicResource MenuTopStripRadius}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header (draggable) -->
                    <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Margin="10,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon x:Name="HeaderIcon" Grid.Column="0" IconKey="zap" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource MenuAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="SmartNotes" FontFamily="{DynamicResource MenuHeaderFont}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Padding="0" Click="BtnClose_Click">
                                <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.2" Foreground="{DynamicResource MenuLabelMutedBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Row="1" Margin="20,18,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <skins:CutBorder Grid.Column="0" x:Name="IconBadge" Width="44" Height="44" CornerRadius="{DynamicResource MenuChoiceRadius}" Cut="{DynamicResource MenuChoiceCut}"
                                         Background="{DynamicResource MenuChoiceBgBrush}" BorderBrush="{DynamicResource MenuChoiceIdleBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,16,0">
                            <controls:LucideIcon x:Name="MainIcon" IconKey="sparkles" Size="22" StrokeThickness="2.0" Foreground="{DynamicResource MenuAccentBrush}"/>
                        </skins:CutBorder>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeading" Text="Heading Text" FontFamily="{DynamicResource MenuItemFont}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MenuItemTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtMessage" Text="Message description text goes here." FontFamily="{DynamicResource MenuLabelFont}" FontSize="{DynamicResource MenuLabelFontSize}" Foreground="{DynamicResource MenuLabelMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                        </StackPanel>
                    </Grid>

                    <!-- Buttons -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,0" Margin="10,0" Padding="6,12,6,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSecondary" Click="BtnSecondary_Click" Content="Cancel" MinWidth="84" Height="34" Margin="0,0,10,0" Padding="14,0" FontSize="13.5" FontWeight="SemiBold" Style="{DynamicResource PopupChoiceButtonStyle}" Visibility="Collapsed"/>
                            <Button x:Name="BtnPrimary" Click="BtnPrimary_Click" Content="OK" MinWidth="92" Height="34" Padding="14,0" FontSize="13.5" FontWeight="Bold" Style="{DynamicResource PopupPrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </skins:CutBorder>
    </Grid>
</Window>

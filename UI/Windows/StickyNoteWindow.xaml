<Window x:Class="SmartNotes.UI.Windows.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        mc:Ignorable="d"
        Title="SmartNote"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="260" MinHeight="200"
        Width="340" Height="360"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <!-- True Single-Border Rounded Card (Thick 5px vector border, zero black outer pixels, zero inner seams) -->
        <Border x:Name="NoteCardBorder" CornerRadius="16" Background="#1C1710" BorderBrush="#5A3E16" BorderThickness="5">
        <Grid Margin="-1">
            <Grid.RowDefinitions>
                <!-- 1. Header & Actions Bar -->
                <RowDefinition Height="44"/>
                <!-- 2. Title Input -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Note Content Body (Text, Checklist, or Copy Compartments) -->
                <RowDefinition Height="*"/>
                <!-- 4. Footer Info & Resize Grip -->
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER (Clean Drag bar + Action Buttons with Separated Compartments) -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="#281E12" BorderBrush="#5A3E16" BorderThickness="0,0,0,3" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Pin Status & New Note -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center Spacer (Clean Drag Area) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Modes, Tools, More, Close -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Action Buttons (New Note & Pin Mode Compartment) -->
                    <Border x:Name="LeftCompartmentBorder" Background="#182030" BorderBrush="#2F3E5E" BorderThickness="2" CornerRadius="8" Padding="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- New Note Button -->
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnNewNote_Click" ToolTip="Create new sticky note (+)">
                                <controls:LucideIcon IconKey="plus" Size="15" StrokeThickness="2.8" Foreground="#F59E0B" x:Name="IconPlus"/>
                            </Button>

                            <!-- Pin / Stick Mode Toggle Button -->
                            <Button x:Name="BtnPinMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnPinMode_Click" ToolTip="Toggle Desktop Stuck (Behind Apps) / Always on Top" Margin="1,0,0,0">
                                <controls:LucideIcon x:Name="IconPin" IconKey="pin" Size="15" StrokeThickness="2.6" Foreground="#A8B5CD"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mode Switcher Compartment (Text, Checklist, Copy Compartments) -->
                        <Border x:Name="ModeCompartmentBorder" Background="#141A28" BorderBrush="#26334D" BorderThickness="2" CornerRadius="8" Margin="0,0,5,0" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <!-- Text Mode Button -->
                                <Button x:Name="BtnTextMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnTextMode_Click" ToolTip="Switch to Text Note Mode">
                                    <controls:LucideIcon x:Name="IconTextMode" IconKey="file-text" Size="15" StrokeThickness="2.6" Foreground="#F59E0B"/>
                                </Button>

                                <!-- Checklist Mode Button -->
                                <Button x:Name="BtnChecklistMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnChecklistMode_Click" ToolTip="Switch to Checklist Mode" Margin="1,0,0,0">
                                    <controls:LucideIcon x:Name="IconChecklistMode" IconKey="list-todo" Size="15" StrokeThickness="2.6" Foreground="#A8B5CD"/>
                                </Button>

                                <!-- Copy Compartments Mode Button -->
                                <Button x:Name="BtnCopyMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnCopyMode_Click" ToolTip="Switch to Copy Compartments Mode (Quick-Copy rows)" Margin="1,0,0,0">
                                    <controls:LucideIcon x:Name="IconCopyMode" IconKey="copy" Size="15" StrokeThickness="2.6" Foreground="#A8B5CD"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Note Tools Compartment (Color, Lock) -->
                        <Border x:Name="ToolsCompartmentBorder" Background="#141A28" BorderBrush="#26334D" BorderThickness="2" CornerRadius="8" Margin="0,0,5,0" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <!-- Color & Transparency Picker Button with Popup -->
                                <Button x:Name="BtnColorPicker" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnColorPicker_Click" ToolTip="Colors, Themes &amp; Transparency">
                                    <controls:LucideIcon IconKey="palette" Size="15" StrokeThickness="2.6" Foreground="#A8B5CD"/>
                                </Button>

                                <!-- Lock Note Button -->
                                <Button x:Name="BtnLock" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnLock_Click" ToolTip="Lock note position &amp; text" Margin="1,0,0,0">
                                    <controls:LucideIcon x:Name="IconLock" IconKey="unlock" Size="15" StrokeThickness="2.6" Foreground="#A8B5CD"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Window & Overflow Controls (More, Close) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- More Menu Button -->
                            <Button x:Name="BtnMore" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnMore_Click" ToolTip="More options..." Margin="0,0,2,0">
                                <controls:LucideIcon IconKey="more-horizontal" Size="15" StrokeThickness="2.6" Foreground="#A8B5CD"/>
                            </Button>

                            <!-- Close / Delete Note Button -->
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnClose_Click" ToolTip="Delete note">
                                <controls:LucideIcon IconKey="x" Size="15" StrokeThickness="2.8" Foreground="#EF4444"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. TITLE BAR (Editable Note Title) -->
            <Border Grid.Row="1" Background="Transparent" Padding="14,8,14,4">
                <Grid>
                    <TextBox x:Name="TxtTitle"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFBEB"
                             FontSize="16.5"
                             FontWeight="Bold"
                             CaretBrush="#F59E0B"
                             Cursor="IBeam"
                             Padding="0"
                             TextChanged="TxtTitle_TextChanged"
                             GotFocus="TxtTitle_GotFocus"
                             LostFocus="TxtTitle_LostFocus"/>
                    <TextBlock x:Name="TxtTitlePlaceholder"
                               Text="Title (optional)..."
                               Foreground="#7888A4"
                               FontSize="16.5"
                               FontWeight="SemiBold"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>
                </Grid>
            </Border>

            <!-- 3. NOTE CONTENT BODY -->
            <Grid Grid.Row="2" Margin="14,4,14,4">
                <!-- MODE A: Multiline Plain/Markdown Text Editor -->
                <Grid x:Name="TextModeContainer" Visibility="Visible">
                    <TextBox x:Name="TxtContent"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFBEB"
                             FontSize="16"
                             FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="#F59E0B"
                             Cursor="IBeam"
                             Padding="2"
                             TextChanged="TxtContent_TextChanged"
                             GotFocus="TxtContent_GotFocus"
                             LostFocus="TxtContent_LostFocus"/>
                    <TextBlock x:Name="TxtContentPlaceholder"
                               Text="Type your note here..."
                               Foreground="#64748B"
                               FontSize="16"
                               FontStyle="Italic"
                               IsHitTestVisible="False"
                               Margin="2,2,0,0"
                               Visibility="Visible"/>
                </Grid>

                <!-- MODE B: Interactive Checklist Container -->
                <Grid x:Name="ChecklistModeContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Checklist Items List -->
                        <RowDefinition Height="*"/>
                        <!-- Add New Task Input -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Tasks -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl x:Name="ChecklistItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141824" BorderBrush="#2A3752" BorderThickness="2" CornerRadius="8" Margin="0,2,0,4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox with 2.5px thick border -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}" Click="CheckItem_Click" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0">
                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                                        <Grid Width="20" Height="20">
                                                            <Border x:Name="Box" CornerRadius="5" Background="#1E2638" BorderBrush="#3B4C6F" BorderThickness="2.5"/>
                                                            <Path x:Name="CheckMark" Data="M 3.5 10 L 8 14.5 L 16.5 4.5" Stroke="#10B981" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                 <Setter TargetName="Box" Property="Background" Value="#0F2922"/>
                                                                <Setter TargetName="Box" Property="BorderBrush" Value="#10B981"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </CheckBox.Template>
                                            </CheckBox>

                                            <!-- Task Text -->
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="TaskText_Changed" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="15" CaretBrush="#F59E0B" VerticalAlignment="Center" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>

                                            <!-- Delete Task Item Button -->
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Click="BtnDeleteTask_Click" ToolTip="Delete task" Padding="3">
                                                <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.6" Foreground="#7888A4"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Item Row (2.5px thick border) -->
                    <Border x:Name="NewTaskContainer" Grid.Row="1" Background="#161D2E" CornerRadius="9" BorderBrush="#303E5C" BorderThickness="2.5" Padding="8,4" Cursor="IBeam" MouseLeftButtonDown="NewTaskContainer_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewTask" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="15" CaretBrush="#F59E0B" Cursor="IBeam" VerticalAlignment="Stretch" VerticalContentAlignment="Center" KeyDown="TxtNewTask_KeyDown" TextChanged="TxtNewTask_TextChanged" GotFocus="TxtNewTask_GotFocus" LostFocus="TxtNewTask_LostFocus"/>
                            <TextBlock x:Name="TxtNewTaskPlaceholder" Text="Add new task (Press Enter)..." Foreground="#64748B" FontSize="14.5" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" Click="BtnAddTask_Click" ToolTip="Add task" Cursor="Hand">
                                <controls:LucideIcon IconKey="plus" Size="15" StrokeThickness="2.8" Foreground="{StaticResource NeonEmeraldGlowBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MODE C: Interactive Copy Compartments Container -->
                <Grid x:Name="CopyModeContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Copy Items List -->
                        <RowDefinition Height="*"/>
                        <!-- Add New Copy Item Input -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Copy Items -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl x:Name="CopyItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141824" BorderBrush="#2A3752" BorderThickness="2" CornerRadius="8" Margin="0,2,0,4" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Snippet Text Input -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Copy Button directly to the right in the same line -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Delete Button -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Snippet Text Box -->
                                            <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="CopyItemText_Changed" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="15" CaretBrush="#F59E0B" Cursor="IBeam" VerticalAlignment="Center" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>

                                            <!-- Dedicated Copy Button on the right in the same line -->
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnCopyRow_Click" ToolTip="Copy this line to clipboard" Margin="4,0,2,0" Padding="4">
                                                <controls:LucideIcon IconKey="copy" Size="14" StrokeThickness="2.6" Foreground="{StaticResource NeonCyanBrush}"/>
                                            </Button>

                                            <!-- Delete Row Button -->
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" Click="BtnDeleteCopyItem_Click" ToolTip="Delete item" Padding="3">
                                                <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.6" Foreground="#7888A4"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Copy Item Row -->
                    <Border x:Name="NewCopyItemContainer" Grid.Row="1" Background="#161D2E" CornerRadius="9" BorderBrush="#303E5C" BorderThickness="2.5" Padding="8,4" Cursor="IBeam" MouseLeftButtonDown="NewCopyItemContainer_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewCopyItem" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="15" CaretBrush="#F59E0B" Cursor="IBeam" VerticalAlignment="Stretch" VerticalContentAlignment="Center" KeyDown="TxtNewCopyItem_KeyDown" TextChanged="TxtNewCopyItem_TextChanged" GotFocus="TxtNewCopyItem_GotFocus" LostFocus="TxtNewCopyItem_LostFocus"/>
                            <TextBlock x:Name="TxtNewCopyItemPlaceholder" Text="Add new copy item (Press Enter)..." Foreground="#64748B" FontSize="14.5" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" Click="BtnAddCopyItem_Click" ToolTip="Add copy item" Cursor="Hand">
                                <controls:LucideIcon IconKey="plus" Size="15" StrokeThickness="2.8" Foreground="{StaticResource NeonCyanBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. BOTTOM FOOTER (Modified Time, Typing Indicator, Lock Badge) -->
            <Border Grid.Row="3" Background="Transparent" Padding="14,0,10,6" VerticalAlignment="Bottom">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPinIndicator" Text="📌 Stuck to Desktop" FontSize="12" FontWeight="SemiBold" Foreground="#A8B5CD" Margin="0,0,12,0"/>
                        
                        <!-- Default Modified Timestamp -->
                        <TextBlock x:Name="TxtModifiedTime" Text="Just now" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                        <!-- Live Typing & Save Status Indicator -->
                        <StackPanel x:Name="TypingIndicatorContainer" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <controls:LucideIcon x:Name="IconTypingStatus" IconKey="pen-line" Size="12" StrokeThickness="2.4" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTypingStatus" Text="Typing..." FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Lock Badge if locked -->
                    <StackPanel x:Name="LockBadge" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed">
                        <controls:LucideIcon IconKey="lock" Size="13" StrokeThickness="2.4" Foreground="#F59E0B" Margin="0,0,4,0"/>
                        <TextBlock Text="LOCKED" FontSize="11.5" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- COLOR PALETTE POPUP (Obsidian Theme with Classic 2D Drawing-App Color Picker) -->
            <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=BtnColorPicker}" Placement="Bottom" PopupAnimation="Fade" Opened="ColorPopup_Opened">
                <Border Background="#101522" BorderBrush="#2F3E5E" BorderThickness="2.5" CornerRadius="14" Padding="12" Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Width="220">
                        <!-- Top Header: Title & Quick Presets -->
                        <TextBlock Text="Quick Neon Themes" FontSize="11" FontWeight="Bold" Foreground="#8898B4" Margin="2,0,0,6"/>

                        <!-- 8 Presets in a clean 4x2 UniformGrid with ZERO dead space -->
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Amber" Click="ColorSwatch_Click" ToolTip="Radiant Amber">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#F59E0B" BorderBrush="#FDE68A" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Emerald" Click="ColorSwatch_Click" ToolTip="Neon Emerald">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#10B981" BorderBrush="#A7F3D0" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Violet" Click="ColorSwatch_Click" ToolTip="Cyber Violet">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#8B5CF6" BorderBrush="#DDD6FE" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Cyan" Click="ColorSwatch_Click" ToolTip="Electric Cyan">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#06B6D4" BorderBrush="#A5F3FC" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Rose" Click="ColorSwatch_Click" ToolTip="Coral Rose">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#F43F5E" BorderBrush="#FECDD3" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Obsidian" Click="ColorSwatch_Click" ToolTip="Stealth Obsidian">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#3B82F6" BorderBrush="#93C5FD" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Gold" Click="ColorSwatch_Click" ToolTip="Classic Sticky Gold">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#EAB308" BorderBrush="#FEF08A" BorderThickness="2"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="2" Tag="Mint" Click="ColorSwatch_Click" ToolTip="Fresh Mint">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#14B8A6" BorderBrush="#99F6E4" BorderThickness="2"/>
                            </Button>
                        </UniformGrid>

                        <Separator Background="#222D42" Margin="0,0,0,10"/>

                        <!-- Classic 2D Saturation / Value Gradient Canvas -->
                        <TextBlock Text="Custom Palette Canvas" FontSize="11" FontWeight="Bold" Foreground="#8898B4" Margin="2,0,0,6"/>

                        <Border Width="220" Height="120" CornerRadius="8" ClipToBounds="True" BorderBrush="#2C3B58" BorderThickness="1.5" Margin="0,0,0,8" Cursor="Cross">
                            <Grid x:Name="SatValPickerGrid" Background="Transparent" MouseLeftButtonDown="SatValPicker_MouseDown" MouseMove="SatValPicker_MouseMove" MouseLeftButtonUp="SatValPicker_MouseUp">
                                <!-- Base pure hue rectangle -->
                                <Rectangle x:Name="HueBaseRect" Fill="#FF0000"/>

                                <!-- Horizontal white gradient (Saturation: 0 to 1) -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Vertical black gradient (Value: 1 to 0) -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#FF000000" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Draggable Crosshair Thumb -->
                                <Canvas x:Name="SatValCanvas" IsHitTestVisible="False">
                                    <Ellipse x:Name="SatValThumb" Width="14" Height="14" Margin="-7,-7,0,0"
                                             Stroke="#FFFFFF" StrokeThickness="2.5" Fill="Transparent">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Classic Hue Rainbow Spectrum Bar -->
                        <Border Width="220" Height="14" CornerRadius="7" ClipToBounds="True" BorderBrush="#2C3B58" BorderThickness="1.5" Margin="0,0,0,10" Cursor="Hand">
                            <Grid x:Name="HueBarGrid" Background="Transparent" MouseLeftButtonDown="HueBar_MouseDown" MouseMove="HueBar_MouseMove" MouseLeftButtonUp="HueBar_MouseUp">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                            <GradientStop Color="#FFFF00" Offset="0.17"/>
                                            <GradientStop Color="#00FF00" Offset="0.33"/>
                                            <GradientStop Color="#00FFFF" Offset="0.50"/>
                                            <GradientStop Color="#0000FF" Offset="0.67"/>
                                            <GradientStop Color="#FF00FF" Offset="0.83"/>
                                            <GradientStop Color="#FF0000" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Draggable Hue Thumb -->
                                <Canvas x:Name="HueCanvas" IsHitTestVisible="False">
                                    <Border x:Name="HueThumb" Width="8" Height="18" Margin="-4,-2,0,0"
                                            CornerRadius="4" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.7" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Bottom Controls: Swatch, Hex Input, Apply Button -->
                        <Grid Width="220" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live Color Preview Swatch -->
                            <Border Grid.Column="0" x:Name="CustomColorPreview" Width="30" Height="30" CornerRadius="6" Background="#FF5500" BorderBrush="#FFFFFF" BorderThickness="2" Margin="0,0,8,0"/>

                            <!-- Hex Input Box -->
                            <TextBox Grid.Column="1" x:Name="TxtCustomHex" Text="#FF5500" Background="#141B2B" BorderBrush="#2F3E5D" BorderThickness="1.5" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Padding="6,4" VerticalContentAlignment="Center" CaretBrush="#F59E0B" Cursor="IBeam" Margin="0,0,8,0" TextChanged="TxtCustomHex_TextChanged"/>

                            <!-- Apply Button -->
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="30" Content="Apply" Click="BtnApplyCustomColor_Click" FontSize="12" FontWeight="Bold" Padding="12,0"/>
                        </Grid>

                        <!-- TRANSPARENCY & DIMMING SECTION -->
                        <Separator Background="#222D42" Margin="0,2,0,10"/>

                        <TextBlock Text="Transparency &amp; Dimming" FontSize="11" FontWeight="Bold" Foreground="#8898B4" Margin="2,0,0,8"/>

                        <!-- Note Solid Opacity Row -->
                        <Grid Margin="2,0,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Note Opacity" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtActiveOpacityPercent" Grid.Column="1" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="SliderActiveOpacity" Minimum="30" Maximum="100" Value="100" SmallChange="5" LargeChange="10" Margin="2,0,2,10" ValueChanged="SliderActiveOpacity_ValueChanged"/>

                        <!-- Unfocused Dimming Toggle -->
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dim When Unfocused" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkUnfocusedDim" Grid.Column="1" Style="{StaticResource ModernSwitch}" IsChecked="True" Click="ChkUnfocusedDim_Click"/>
                        </Grid>

                        <!-- Unfocused Opacity Factor Slider -->
                        <StackPanel x:Name="UnfocusedOpacityControlsPanel" Margin="2,0,2,2">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Unfocused Opacity" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUnfocusedOpacityPercent" Grid.Column="1" Text="55%" FontSize="12" FontWeight="Bold" Foreground="#06B6D4" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="SliderUnfocusedOpacity" Minimum="15" Maximum="90" Value="55" SmallChange="5" LargeChange="10" ValueChanged="SliderUnfocusedOpacity_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </Border>

    <!-- 8-Way Multi-Directional Window Resize Hit-Zones (Top, Bottom, Left, Right, 4 Corners) -->
    <Grid x:Name="ResizeOverlayGrid" IsHitTestVisible="True">
        <!-- 4 Edge Rectangles -->
        <Rectangle x:Name="ResizeEdgeTop" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="14,0,14,0" Fill="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeEdgeBottom" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="14,0,14,0" Fill="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeEdgeLeft" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" Fill="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeEdgeRight" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,14,0,14" Fill="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>

        <!-- 4 Corner Rectangles -->
        <Rectangle x:Name="ResizeCornerTopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeCornerTopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeCornerBottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeCornerBottomRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
    </Grid>
</Grid>
</Window>

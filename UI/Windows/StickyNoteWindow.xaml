<Window x:Class="SmartNotes.UI.Windows.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        xmlns:skins="clr-namespace:SmartNotes.UI.Skins"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="SmartNote"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="260" MinHeight="200"
        Width="340" Height="360"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Lock state for the checklist / copy rows (set in UpdateLockUI) -->
        <sys:Boolean x:Key="NoteItemsReadOnly">False</sys:Boolean>
        <sys:Boolean x:Key="NoteItemsEditable">True</sys:Boolean>
        <!-- Row tooltips, localized in ApplyLocalizedStrings -->
        <sys:String x:Key="StrDragToReorder">Drag to reorder</sys:String>
        <sys:String x:Key="StrDeleteTask">Delete task</sys:String>
        <sys:String x:Key="StrCopyRow">Copy this line to clipboard</sys:String>
        <sys:String x:Key="StrDeleteItem">Delete item</sys:String>
        <!-- Skin tokens: defaults = Classic skin. StickyNoteWindow.ApplySkin() overwrites them per note (see NoteSkin.cs). -->
        <SolidColorBrush x:Key="SkinAccentBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="SkinAccentDimBrush" Color="#614418"/>
        <SolidColorBrush x:Key="SkinPanelBgBrush" Color="#141A28"/>
        <SolidColorBrush x:Key="SkinPanelBorderBrush" Color="#26334D"/>
        <SolidColorBrush x:Key="SkinItemBgBrush" Color="#141824"/>
        <SolidColorBrush x:Key="SkinItemBorderBrush" Color="#2A3752"/>
        <SolidColorBrush x:Key="SkinInputBgBrush" Color="#161D2E"/>
        <SolidColorBrush x:Key="SkinInputBorderBrush" Color="#303E5C"/>
        <SolidColorBrush x:Key="SkinItemTextBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SkinCheckBgBrush" Color="#1E2638"/>
        <SolidColorBrush x:Key="SkinCheckBorderBrush" Color="#3B4C6F"/>
        <SolidColorBrush x:Key="SkinCheckMarkBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="SkinCheckOnBgBrush" Color="#0F2922"/>
        <CornerRadius x:Key="SkinCheckRadius">5</CornerRadius>
        <sys:Double x:Key="SkinCompartmentCut">0</sys:Double>
        <sys:Double x:Key="SkinItemCut">0</sys:Double>
        <sys:Double x:Key="SkinItemFontSize">15</sys:Double>
        <sys:Double x:Key="SkinHintFontSize">14.5</sys:Double>
        <CornerRadius x:Key="SkinCompartmentRadius">8</CornerRadius>
        <Thickness x:Key="SkinCompartmentBorder">2</Thickness>
        <CornerRadius x:Key="SkinItemRadius">8</CornerRadius>
        <Thickness x:Key="SkinItemBorder">2</Thickness>
        <CornerRadius x:Key="SkinInputRadius">9</CornerRadius>
        <Thickness x:Key="SkinInputBorder">2.5</Thickness>
        <FontFamily x:Key="SkinFont">Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
        <FontFamily x:Key="SkinTitleFont">Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
        <FontFamily x:Key="SkinMetaFont">Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
        <FontWeight x:Key="SkinBodyWeight">Normal</FontWeight>
        <FontWeight x:Key="SkinTitleWeight">Bold</FontWeight>
        <!-- Chrome ink: icons / helper text sitting directly on the note surface -->
        <SolidColorBrush x:Key="SkinMutedBrush" Color="#A8B5CD"/>
        <SolidColorBrush x:Key="SkinFaintBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="SkinPlaceholderBrush" Color="#7888A4"/>
        <SolidColorBrush x:Key="SkinDangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="SkinAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="SkinEmeraldBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="SkinCyanBrush" Color="#06B6D4"/>
        <SolidColorBrush x:Key="SkinCaretBrush" Color="#F59E0B"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Custom-art skins paint their whole (non-rectangular) body here; see UI/Skins/*Art.cs -->
        <skins:DrawingHost x:Name="SkinArtHost" IsHitTestVisible="False"/>

        <!-- True Single-Border Rounded Card (Thick 5px vector border, zero black outer pixels, zero inner seams) -->
        <Border x:Name="NoteCardBorder" CornerRadius="16" Background="#1C1710" BorderBrush="#5A3E16" BorderThickness="5">
        <Grid x:Name="ContentGrid" Margin="-1">
            <Grid.RowDefinitions>
                <!-- 1. Header & Actions Bar -->
                <RowDefinition x:Name="HeaderRow" Height="44"/>
                <!-- 2. Title Input -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Note Content Body (Text, Checklist, or Copy Compartments) -->
                <RowDefinition Height="*"/>
                <!-- 4. Footer Info & Resize Grip -->
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER (Clean Drag bar + Action Buttons with Separated Compartments) -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="#281E12" BorderBrush="#5A3E16" BorderThickness="0,0,0,3" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Pin Status & New Note -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center Spacer (Clean Drag Area) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Modes, Tools, More, Close -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Action Buttons (New Note & Pin Mode Compartment) -->
                    <skins:CutBorder Cut="{DynamicResource SkinCompartmentCut}" x:Name="LeftCompartmentBorder" Background="#182030" BorderBrush="#2F3E5E" BorderThickness="{DynamicResource SkinCompartmentBorder}" CornerRadius="{DynamicResource SkinCompartmentRadius}" Padding="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- New Note Button -->
                            <Button x:Name="BtnNewNote" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnNewNote_Click" ToolTip="Create new sticky note (+)">
                                <controls:LucideIcon IconKey="plus" Size="15" StrokeThickness="2.8" Foreground="#F59E0B" x:Name="IconPlus"/>
                            </Button>

                            <!-- Pin / Stick Mode Toggle Button -->
                            <Button x:Name="BtnPinMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnPinMode_Click" ToolTip="Toggle Desktop Stuck (Behind Apps) / Always on Top" Margin="1,0,0,0">
                                <controls:LucideIcon x:Name="IconPin" IconKey="pin" Size="15" StrokeThickness="2.6" Foreground="{DynamicResource SkinMutedBrush}"/>
                            </Button>
                        </StackPanel>
                    </skins:CutBorder>

                    <!-- Right Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mode Switcher Compartment (Text, Checklist, Copy Compartments) -->
                        <skins:CutBorder Cut="{DynamicResource SkinCompartmentCut}" x:Name="ModeCompartmentBorder" Background="#141A28" BorderBrush="#26334D" BorderThickness="{DynamicResource SkinCompartmentBorder}" CornerRadius="{DynamicResource SkinCompartmentRadius}" Margin="0,0,5,0" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <!-- Text Mode Button -->
                                <Button x:Name="BtnTextMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnTextMode_Click" ToolTip="Switch to Text Note Mode">
                                    <controls:LucideIcon x:Name="IconTextMode" IconKey="file-text" Size="15" StrokeThickness="2.6" Foreground="#F59E0B"/>
                                </Button>

                                <!-- Checklist Mode Button -->
                                <Button x:Name="BtnChecklistMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnChecklistMode_Click" ToolTip="Switch to Checklist Mode" Margin="1,0,0,0">
                                    <controls:LucideIcon x:Name="IconChecklistMode" IconKey="list-todo" Size="15" StrokeThickness="2.6" Foreground="{DynamicResource SkinMutedBrush}"/>
                                </Button>

                                <!-- Copy Compartments Mode Button -->
                                <Button x:Name="BtnCopyMode" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnCopyMode_Click" ToolTip="Switch to Copy Compartments Mode (Quick-Copy rows)" Margin="1,0,0,0">
                                    <controls:LucideIcon x:Name="IconCopyMode" IconKey="copy" Size="15" StrokeThickness="2.6" Foreground="{DynamicResource SkinMutedBrush}"/>
                                </Button>
                            </StackPanel>
                        </skins:CutBorder>

                        <!-- Note Tools Compartment (Color, Lock) -->
                        <skins:CutBorder Cut="{DynamicResource SkinCompartmentCut}" x:Name="ToolsCompartmentBorder" Background="#141A28" BorderBrush="#26334D" BorderThickness="{DynamicResource SkinCompartmentBorder}" CornerRadius="{DynamicResource SkinCompartmentRadius}" Margin="0,0,5,0" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <!-- Color & Transparency Picker Button with Popup -->
                                <Button x:Name="BtnColorPicker" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnColorPicker_Click" ToolTip="Colors, Themes &amp; Transparency">
                                    <controls:LucideIcon IconKey="palette" Size="15" StrokeThickness="2.6" Foreground="{DynamicResource SkinMutedBrush}"/>
                                </Button>

                                <!-- Lock Note Button -->
                                <Button x:Name="BtnLock" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnLock_Click" ToolTip="Lock note position &amp; text" Margin="1,0,0,0">
                                    <controls:LucideIcon x:Name="IconLock" IconKey="unlock" Size="15" StrokeThickness="2.6" Foreground="{DynamicResource SkinMutedBrush}"/>
                                </Button>
                            </StackPanel>
                        </skins:CutBorder>

                        <!-- Window & Overflow Controls (More, Close) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- More Menu Button -->
                            <Button x:Name="BtnMore" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnMore_Click" ToolTip="More options..." Margin="0,0,2,0">
                                <controls:LucideIcon IconKey="more-horizontal" Size="15" StrokeThickness="2.6" Foreground="{DynamicResource SkinMutedBrush}"/>
                            </Button>

                            <!-- Close / Delete Note Button -->
                            <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnClose_Click" ToolTip="Delete note">
                                <controls:LucideIcon IconKey="x" Size="15" StrokeThickness="2.8" Foreground="{DynamicResource SkinDangerBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. TITLE BAR (Editable Note Title) -->
            <Border Grid.Row="1" Background="Transparent" Padding="14,8,14,4">
                <Grid>
                    <TextBox x:Name="TxtTitle"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFBEB"
                             FontFamily="{DynamicResource SkinTitleFont}"
                             FontSize="16.5"
                             FontWeight="{DynamicResource SkinTitleWeight}"
                             CaretBrush="#F59E0B"
                             Cursor="IBeam"
                             Padding="0"
                             SpellCheck.IsEnabled="True"
                             PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown"
                             PreviewMouseRightButtonUp="TextBox_PreviewMouseRightButtonUp"
                             ContextMenuOpening="TextBox_ContextMenuOpening"
                             PreviewTextInput="TextBox_PreviewTextInput"
                             PreviewKeyDown="TextBox_PreviewKeyDown"
                             TextChanged="TxtTitle_TextChanged"
                             GotFocus="TxtTitle_GotFocus"
                             LostFocus="TxtTitle_LostFocus"/>
                    <TextBlock x:Name="TxtTitlePlaceholder"
                               Text="Title (optional)..."
                               Foreground="{DynamicResource SkinPlaceholderBrush}"
                               FontFamily="{DynamicResource SkinTitleFont}"
                               FontSize="16.5"
                               FontWeight="SemiBold"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>
                </Grid>
            </Border>

            <!-- 3. NOTE CONTENT BODY -->
            <Grid Grid.Row="2" Margin="14,4,14,4">
                <!-- Reminder banner: shown when a reminder fires, until Done or Snooze (glows in the note colour) -->
                <Border x:Name="ReminderBanner" Panel.ZIndex="10" VerticalAlignment="Top" Padding="10,4,4,4"
                        CornerRadius="{DynamicResource SkinInputRadius}" BorderThickness="2" Visibility="Collapsed"
                        Background="{DynamicResource SkinInputBgBrush}" BorderBrush="{DynamicResource SkinAccentBrush}">
                    <Border.Effect>
                        <DropShadowEffect x:Name="ReminderGlow" ShadowDepth="0" BlurRadius="18" Opacity="0.9" Color="#F59E0B"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:LucideIcon x:Name="IconReminderBanner" IconKey="bell" Size="15" StrokeThickness="2.4" Foreground="{DynamicResource SkinAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtReminderBanner" Grid.Column="1" Text="Reminder" Foreground="{DynamicResource SkinItemTextBrush}" FontFamily="{DynamicResource SkinMetaFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnReminderSnooze" Grid.Column="2" Style="{StaticResource IconButton}" Height="26" Padding="7,0" Margin="6,0,0,0" Click="BtnReminderSnooze_Click">
                            <TextBlock x:Name="TxtReminderSnooze" Text="10 min" FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkinMutedBrush}"/>
                        </Button>
                        <Button x:Name="BtnReminderDone" Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="26" Padding="0" Margin="2,0,0,0" Click="BtnReminderDone_Click">
                            <controls:LucideIcon IconKey="check" Size="15" StrokeThickness="2.8" Foreground="{DynamicResource SkinEmeraldBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- MODE A: Multiline Plain/Markdown Text Editor -->
                <Grid x:Name="TextModeContainer" Visibility="Visible">
                    <TextBox x:Name="TxtContent"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FFFBEB"
                             FontSize="16"
                             FontFamily="{DynamicResource SkinFont}"
                             FontWeight="{DynamicResource SkinBodyWeight}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="#F59E0B"
                             Cursor="IBeam"
                             Padding="2"
                             SpellCheck.IsEnabled="True"
                             PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown"
                             PreviewMouseRightButtonUp="TextBox_PreviewMouseRightButtonUp"
                             ContextMenuOpening="TextBox_ContextMenuOpening"
                             PreviewTextInput="TextBox_PreviewTextInput"
                             PreviewKeyDown="TextBox_PreviewKeyDown"
                             TextChanged="TxtContent_TextChanged"
                             GotFocus="TxtContent_GotFocus"
                             LostFocus="TxtContent_LostFocus"/>
                    <TextBlock x:Name="TxtContentPlaceholder"
                               Text="Type your note here..."
                               Foreground="{DynamicResource SkinFaintBrush}"
                               FontFamily="{DynamicResource SkinFont}"
                               FontSize="16"
                               FontStyle="Italic"
                               IsHitTestVisible="False"
                               Margin="2,2,0,0"
                               Visibility="Visible"/>
                </Grid>

                <!-- MODE B: Interactive Checklist Container -->
                <Grid x:Name="ChecklistModeContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Checklist Items List -->
                        <RowDefinition Height="*"/>
                        <!-- Add New Task Input -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Tasks -->
                    <ScrollViewer x:Name="ChecklistScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <!-- Rows are dragged physically (lifted into a floating ghost) by ListItemDragController, see SetupItemDrag -->
                        <ItemsControl x:Name="ChecklistItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <skins:CutBorder Cut="{DynamicResource SkinItemCut}" Background="{DynamicResource SkinItemBgBrush}" BorderBrush="{DynamicResource SkinItemBorderBrush}" BorderThickness="{DynamicResource SkinItemBorder}" CornerRadius="{DynamicResource SkinItemRadius}" Margin="0,2,0,4" Padding="2,6,8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag grip (six dots) -->
                                            <Border x:Name="TaskGrip" Tag="DragGrip" Grid.Column="0" Width="16" Background="Transparent" Cursor="SizeAll" Margin="0,0,2,0" ToolTip="{DynamicResource StrDragToReorder}">
                                                <Path Data="M 1.7 2 A 1.3 1.3 0 1 0 4.3 2 A 1.3 1.3 0 1 0 1.7 2 Z M 6.7 2 A 1.3 1.3 0 1 0 9.3 2 A 1.3 1.3 0 1 0 6.7 2 Z M 1.7 7 A 1.3 1.3 0 1 0 4.3 7 A 1.3 1.3 0 1 0 1.7 7 Z M 6.7 7 A 1.3 1.3 0 1 0 9.3 7 A 1.3 1.3 0 1 0 6.7 7 Z M 1.7 12 A 1.3 1.3 0 1 0 4.3 12 A 1.3 1.3 0 1 0 1.7 12 Z M 6.7 12 A 1.3 1.3 0 1 0 9.3 12 A 1.3 1.3 0 1 0 6.7 12 Z"
                                                      Fill="{DynamicResource SkinMutedBrush}" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Border>

                                            <!-- Checkbox with 2.5px thick border -->
                                            <CheckBox x:Name="TaskCheck" Grid.Column="1" IsChecked="{Binding IsDone}" Checked="CheckItem_Changed" Unchecked="CheckItem_Changed" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0">
                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                                        <Grid Width="20" Height="20">
                                                            <Border x:Name="Box" CornerRadius="{DynamicResource SkinCheckRadius}" Background="{DynamicResource SkinCheckBgBrush}" BorderBrush="{DynamicResource SkinCheckBorderBrush}" BorderThickness="2.5"/>
                                                            <Path x:Name="CheckMark" Data="M 3.5 10 L 8 14.5 L 16.5 4.5" Stroke="{DynamicResource SkinCheckMarkBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                 <Setter TargetName="Box" Property="Background" Value="{DynamicResource SkinCheckOnBgBrush}"/>
                                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SkinCheckMarkBrush}"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </CheckBox.Template>
                                            </CheckBox>

                                            <!-- Task Text -->
                                            <TextBox Grid.Column="2" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="TaskText_Changed" IsReadOnly="{DynamicResource NoteItemsReadOnly}" Loaded="ItemTextBox_Loaded" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SkinItemTextBrush}" FontFamily="{DynamicResource SkinFont}" FontWeight="{DynamicResource SkinBodyWeight}" FontSize="{DynamicResource SkinItemFontSize}" CaretBrush="{DynamicResource SkinCaretBrush}" VerticalAlignment="Center" SpellCheck.IsEnabled="True" PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="TextBox_PreviewMouseRightButtonUp" ContextMenuOpening="TextBox_ContextMenuOpening" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus">
                                                <!-- Done tasks: struck through and dimmed -->
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TaskCheck}" Value="True">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <!-- Delete Task Item Button -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24" Click="BtnDeleteTask_Click" ToolTip="{DynamicResource StrDeleteTask}" Padding="3" IsEnabled="{DynamicResource NoteItemsEditable}">
                                                <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.6" Foreground="{DynamicResource SkinPlaceholderBrush}"/>
                                            </Button>
                                        </Grid>
                                    </skins:CutBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Item Row (2.5px thick border) -->
                    <skins:CutBorder Cut="{DynamicResource SkinItemCut}" x:Name="NewTaskContainer" Grid.Row="1" Background="{DynamicResource SkinInputBgBrush}" CornerRadius="{DynamicResource SkinInputRadius}" BorderBrush="{DynamicResource SkinInputBorderBrush}" BorderThickness="{DynamicResource SkinInputBorder}" Padding="8,4" Cursor="IBeam" MouseLeftButtonDown="NewTaskContainer_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewTask" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SkinItemTextBrush}" FontFamily="{DynamicResource SkinFont}" FontWeight="{DynamicResource SkinBodyWeight}" FontSize="{DynamicResource SkinItemFontSize}" CaretBrush="{DynamicResource SkinCaretBrush}" Cursor="IBeam" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SpellCheck.IsEnabled="True" PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="TextBox_PreviewMouseRightButtonUp" ContextMenuOpening="TextBox_ContextMenuOpening" PreviewTextInput="TextBox_PreviewTextInput" KeyDown="TxtNewTask_KeyDown" TextChanged="TxtNewTask_TextChanged" GotFocus="TxtNewTask_GotFocus" LostFocus="TxtNewTask_LostFocus"/>
                            <TextBlock x:Name="TxtNewTaskPlaceholder" Text="Add new task (Press Enter)..." Foreground="{DynamicResource SkinFaintBrush}" FontFamily="{DynamicResource SkinFont}" FontSize="{DynamicResource SkinHintFontSize}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <Button x:Name="BtnAddTask" Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" Click="BtnAddTask_Click" ToolTip="Add task" Cursor="Hand">
                                <controls:LucideIcon IconKey="plus" Size="15" StrokeThickness="2.8" Foreground="{DynamicResource SkinEmeraldBrush}"/>
                            </Button>
                        </Grid>
                    </skins:CutBorder>
                </Grid>

                <!-- MODE C: Interactive Copy Compartments Container -->
                <Grid x:Name="CopyModeContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Copy Items List -->
                        <RowDefinition Height="*"/>
                        <!-- Add New Copy Item Input -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Copy Items -->
                    <ScrollViewer x:Name="CopyScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl x:Name="CopyItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <skins:CutBorder Cut="{DynamicResource SkinItemCut}" Background="{DynamicResource SkinItemBgBrush}" BorderBrush="{DynamicResource SkinItemBorderBrush}" BorderThickness="{DynamicResource SkinItemBorder}" CornerRadius="{DynamicResource SkinItemRadius}" Margin="0,2,0,4" Padding="2,5,8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Drag grip -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Snippet Text Input -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Copy Button directly to the right in the same line -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Delete Button -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag grip (six dots) -->
                                            <Border Tag="DragGrip" Grid.Column="0" Width="16" Background="Transparent" Cursor="SizeAll" Margin="0,0,4,0" ToolTip="{DynamicResource StrDragToReorder}">
                                                <Path Data="M 1.7 2 A 1.3 1.3 0 1 0 4.3 2 A 1.3 1.3 0 1 0 1.7 2 Z M 6.7 2 A 1.3 1.3 0 1 0 9.3 2 A 1.3 1.3 0 1 0 6.7 2 Z M 1.7 7 A 1.3 1.3 0 1 0 4.3 7 A 1.3 1.3 0 1 0 1.7 7 Z M 6.7 7 A 1.3 1.3 0 1 0 9.3 7 A 1.3 1.3 0 1 0 6.7 7 Z M 1.7 12 A 1.3 1.3 0 1 0 4.3 12 A 1.3 1.3 0 1 0 1.7 12 Z M 6.7 12 A 1.3 1.3 0 1 0 9.3 12 A 1.3 1.3 0 1 0 6.7 12 Z"
                                                      Fill="{DynamicResource SkinMutedBrush}" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Border>

                                            <!-- Snippet Text Box -->
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="CopyItemText_Changed" IsReadOnly="{DynamicResource NoteItemsReadOnly}" Loaded="ItemTextBox_Loaded" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SkinItemTextBrush}" FontFamily="{DynamicResource SkinFont}" FontWeight="{DynamicResource SkinBodyWeight}" FontSize="{DynamicResource SkinItemFontSize}" CaretBrush="{DynamicResource SkinCaretBrush}" Cursor="IBeam" VerticalAlignment="Center" SpellCheck.IsEnabled="True" PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="TextBox_PreviewMouseRightButtonUp" ContextMenuOpening="TextBox_ContextMenuOpening" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>

                                            <!-- Dedicated Copy Button on the right in the same line -->
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Click="BtnCopyRow_Click" ToolTip="{DynamicResource StrCopyRow}" Margin="4,0,2,0" Padding="4">
                                                <controls:LucideIcon IconKey="copy" Size="14" StrokeThickness="2.6" Foreground="{DynamicResource SkinCyanBrush}"/>
                                            </Button>

                                            <!-- Delete Row Button -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24" Click="BtnDeleteCopyItem_Click" ToolTip="{DynamicResource StrDeleteItem}" Padding="3" IsEnabled="{DynamicResource NoteItemsEditable}">
                                                <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.6" Foreground="{DynamicResource SkinPlaceholderBrush}"/>
                                            </Button>
                                        </Grid>
                                    </skins:CutBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Copy Item Row -->
                    <skins:CutBorder Cut="{DynamicResource SkinItemCut}" x:Name="NewCopyItemContainer" Grid.Row="1" Background="{DynamicResource SkinInputBgBrush}" CornerRadius="{DynamicResource SkinInputRadius}" BorderBrush="{DynamicResource SkinInputBorderBrush}" BorderThickness="{DynamicResource SkinInputBorder}" Padding="8,4" Cursor="IBeam" MouseLeftButtonDown="NewCopyItemContainer_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewCopyItem" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SkinItemTextBrush}" FontFamily="{DynamicResource SkinFont}" FontWeight="{DynamicResource SkinBodyWeight}" FontSize="{DynamicResource SkinItemFontSize}" CaretBrush="{DynamicResource SkinCaretBrush}" Cursor="IBeam" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SpellCheck.IsEnabled="True" PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="TextBox_PreviewMouseRightButtonUp" ContextMenuOpening="TextBox_ContextMenuOpening" PreviewTextInput="TextBox_PreviewTextInput" KeyDown="TxtNewCopyItem_KeyDown" TextChanged="TxtNewCopyItem_TextChanged" GotFocus="TxtNewCopyItem_GotFocus" LostFocus="TxtNewCopyItem_LostFocus"/>
                            <TextBlock x:Name="TxtNewCopyItemPlaceholder" Text="Add new copy item (Press Enter)..." Foreground="{DynamicResource SkinFaintBrush}" FontFamily="{DynamicResource SkinFont}" FontSize="{DynamicResource SkinHintFontSize}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <Button x:Name="BtnAddCopyItem" Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26" Click="BtnAddCopyItem_Click" ToolTip="Add copy item" Cursor="Hand">
                                <controls:LucideIcon IconKey="plus" Size="15" StrokeThickness="2.8" Foreground="{DynamicResource SkinCyanBrush}"/>
                            </Button>
                        </Grid>
                    </skins:CutBorder>
                </Grid>
            </Grid>


            <!-- 4. BOTTOM FOOTER (Modified Time, Typing Indicator, Lock Badge) -->
            <Border Grid.Row="3" Background="Transparent" Padding="14,0,10,6" VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Pin / link text, then the modified time. Sized to its content; when the note is narrow the pin text
                         (the filling last child) is shortened with "…" instead of running into the badges on the right. -->
                    <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center" LastChildFill="True">
                        <controls:LucideIcon x:Name="IconPinFooter" DockPanel.Dock="Left" IconKey="pin" Size="12" StrokeThickness="2.4" Foreground="{DynamicResource SkinMutedBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Default Modified Timestamp -->
                            <TextBlock x:Name="TxtModifiedTime" Text="Just now" FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" Foreground="{DynamicResource SkinFaintBrush}" VerticalAlignment="Center"/>

                            <!-- Live Typing & Save Status Indicator -->
                            <StackPanel x:Name="TypingIndicatorContainer" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <controls:LucideIcon x:Name="IconTypingStatus" IconKey="pen-line" Size="12" StrokeThickness="2.4" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTypingStatus" Text="Typing..." FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtPinIndicator" Text="Stuck to Desktop" FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkinMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,18,0">
                    <!-- Reminder set ("14:30", "Fri 09:00"); the tooltip says when and how often -->
                    <StackPanel x:Name="ReminderBadge" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" Background="Transparent">
                        <controls:LucideIcon x:Name="IconReminderBadge" IconKey="bell" Size="12" StrokeThickness="2.4" Foreground="{DynamicResource SkinMutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtReminderBadge" Text="" FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkinMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Repeat daily: the streak of days with every task done -->
                    <StackPanel x:Name="StreakBadge" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" Background="Transparent">
                        <controls:LucideIcon x:Name="IconStreak" IconKey="repeat" Size="12" StrokeThickness="2.4" Foreground="{DynamicResource SkinMutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStreak" Text="" FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkinMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Checklist progress ("3/7"), checklist mode only -->
                    <StackPanel x:Name="ChecklistProgress" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" Background="Transparent">
                        <controls:LucideIcon IconKey="check-check" Size="13" StrokeThickness="2.4" Foreground="{DynamicResource SkinMutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtChecklistProgress" Text="0/0" FontFamily="{DynamicResource SkinMetaFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SkinMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Lock Badge if locked -->
                    <StackPanel x:Name="LockBadge" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <controls:LucideIcon IconKey="lock" Size="13" StrokeThickness="2.4" Foreground="{DynamicResource SkinAmberBrush}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtLockedBadge" Text="LOCKED" FontFamily="{DynamicResource SkinMetaFont}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SkinAmberBrush}"/>
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Elden Ring: ornamental rule under the title -->
            <Grid x:Name="EldenTitleDivider" Grid.Row="1" VerticalAlignment="Bottom" Height="7" Margin="14,0,14,-3" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle x:Name="EldenDividerLine" Height="1" VerticalAlignment="Center"/>
                <Rectangle Width="5" Height="5" Fill="{DynamicResource SkinAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>

            <!-- COLOR PALETTE POPUP (Obsidian Theme with Classic 2D Drawing-App Color Picker) -->
            <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=BtnColorPicker}" Placement="Bottom" PopupAnimation="Fade" Opened="ColorPopup_Opened">
                <!-- Colours, fonts and control styles are Menu*/Popup* resources (DarkTheme.xaml), overridden per skin via SkinMenus.ApplyToPanel -->
                <Grid x:Name="ColorPopupRoot" Margin="0,4,0,4">
                <skins:CutBorder Background="{DynamicResource MenuShadowBrush}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}">
                    <skins:CutBorder.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                    </skins:CutBorder.Effect>
                </skins:CutBorder>
                <skins:CutBorder Background="{DynamicResource MenuPanelBgBrush}" BorderBrush="{DynamicResource MenuPanelBorderBrush}" BorderThickness="{DynamicResource MenuPanelBorderThickness}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}">
                    <DockPanel>
                    <Border DockPanel.Dock="Top" Height="{DynamicResource MenuTopStripHeight}" Background="{DynamicResource MenuTopStripBrush}" CornerRadius="{DynamicResource MenuTopStripRadius}"/>
                    <Border BorderBrush="{DynamicResource MenuPanelInnerFrameBrush}" BorderThickness="1" Margin="2" Padding="9" CornerRadius="{DynamicResource MenuPanelRadius}">
                    <StackPanel Width="220">
                        <!-- Note Style (skin) selector -->
                        <TextBlock x:Name="TxtNoteStyleHeader" Text="Note Style" FontSize="{DynamicResource MenuHeaderFontSize}" FontFamily="{DynamicResource MenuHeaderFont}" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" Margin="2,0,0,6"/>
                        <!-- One button per NoteSkin.All entry, built in BuildSkinButtons() -->
                        <UniformGrid x:Name="SkinButtonsGrid" Columns="2" Margin="0,0,0,10"/>

                        <Separator Background="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,10"/>

                        <!-- Great Runes: replaces the colour section in rune skins (Elden Ring). Built in BuildRuneButtons(). -->
                        <StackPanel x:Name="RuneSection" Visibility="Collapsed">
                            <TextBlock x:Name="TxtGreatRunesHeader" Text="Great Runes" FontSize="{DynamicResource MenuHeaderFontSize}" FontFamily="{DynamicResource MenuHeaderFont}" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" Margin="2,0,0,6"/>
                            <UniformGrid x:Name="RuneButtonsGrid" Columns="5" Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Astral skin: the note's constellation (Automatic + one tile per figure). Built in BuildConstellationButtons(). -->
                        <StackPanel x:Name="ConstellationSection" Visibility="Collapsed">
                            <TextBlock x:Name="TxtConstellationHeader" Text="Constellation" FontSize="{DynamicResource MenuHeaderFontSize}" FontFamily="{DynamicResource MenuHeaderFont}" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" Margin="2,0,0,6"/>
                            <UniformGrid x:Name="ConstellationButtonsGrid" Columns="6" Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel x:Name="ColorSection">
                        <!-- Top Header: Title & Quick Presets -->
                        <TextBlock x:Name="TxtQuickNeonThemes" Text="Quick Neon Themes" FontSize="{DynamicResource MenuHeaderFontSize}" FontFamily="{DynamicResource MenuHeaderFont}" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" Margin="2,0,0,6"/>

                        <!-- 8 Presets in a clean 4x2 UniformGrid with ZERO dead space -->
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Button x:Name="BtnSwatchAmber" Style="{StaticResource IconButton}" Margin="2" Tag="Amber" Click="ColorSwatch_Click" ToolTip="Radiant Amber">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#F59E0B" BorderBrush="#FDE68A" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchEmerald" Style="{StaticResource IconButton}" Margin="2" Tag="Emerald" Click="ColorSwatch_Click" ToolTip="Neon Emerald">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#10B981" BorderBrush="#A7F3D0" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchViolet" Style="{StaticResource IconButton}" Margin="2" Tag="Violet" Click="ColorSwatch_Click" ToolTip="Cyber Violet">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#8B5CF6" BorderBrush="#DDD6FE" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchCyan" Style="{StaticResource IconButton}" Margin="2" Tag="Cyan" Click="ColorSwatch_Click" ToolTip="Electric Cyan">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#06B6D4" BorderBrush="#A5F3FC" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchRose" Style="{StaticResource IconButton}" Margin="2" Tag="Rose" Click="ColorSwatch_Click" ToolTip="Coral Rose">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#F43F5E" BorderBrush="#FECDD3" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchObsidian" Style="{StaticResource IconButton}" Margin="2" Tag="Obsidian" Click="ColorSwatch_Click" ToolTip="Stealth Obsidian">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#3B82F6" BorderBrush="#93C5FD" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchGold" Style="{StaticResource IconButton}" Margin="2" Tag="Gold" Click="ColorSwatch_Click" ToolTip="Classic Sticky Gold">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#EAB308" BorderBrush="#FEF08A" BorderThickness="2"/>
                            </Button>
                            <Button x:Name="BtnSwatchMint" Style="{StaticResource IconButton}" Margin="2" Tag="Mint" Click="ColorSwatch_Click" ToolTip="Fresh Mint">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#14B8A6" BorderBrush="#99F6E4" BorderThickness="2"/>
                            </Button>
                        </UniformGrid>

                        <Separator Background="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,10"/>

                        <!-- Classic 2D Saturation / Value Gradient Canvas -->
                        <TextBlock x:Name="TxtCustomPaletteCanvas" Text="Custom Palette Canvas" FontSize="{DynamicResource MenuHeaderFontSize}" FontFamily="{DynamicResource MenuHeaderFont}" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" Margin="2,0,0,6"/>

                        <Border Width="220" Height="120" CornerRadius="{DynamicResource MenuChoiceRadius}" ClipToBounds="True" BorderBrush="{DynamicResource MenuInputBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Cursor="Cross">
                            <Grid x:Name="SatValPickerGrid" Background="Transparent" MouseLeftButtonDown="SatValPicker_MouseDown" MouseMove="SatValPicker_MouseMove" MouseLeftButtonUp="SatValPicker_MouseUp">
                                <!-- Base pure hue rectangle -->
                                <Rectangle x:Name="HueBaseRect" Fill="#FF0000"/>

                                <!-- Horizontal white gradient (Saturation: 0 to 1) -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Vertical black gradient (Value: 1 to 0) -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#FF000000" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Draggable Crosshair Thumb -->
                                <Canvas x:Name="SatValCanvas" IsHitTestVisible="False">
                                    <Ellipse x:Name="SatValThumb" Width="14" Height="14" Margin="-7,-7,0,0"
                                             Stroke="#FFFFFF" StrokeThickness="2.5" Fill="Transparent">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Classic Hue Rainbow Spectrum Bar -->
                        <Border Width="220" Height="14" CornerRadius="{DynamicResource MenuChoiceRadius}" ClipToBounds="True" BorderBrush="{DynamicResource MenuInputBorderBrush}" BorderThickness="1" Margin="0,0,0,10" Cursor="Hand">
                            <Grid x:Name="HueBarGrid" Background="Transparent" MouseLeftButtonDown="HueBar_MouseDown" MouseMove="HueBar_MouseMove" MouseLeftButtonUp="HueBar_MouseUp">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                            <GradientStop Color="#FFFF00" Offset="0.17"/>
                                            <GradientStop Color="#00FF00" Offset="0.33"/>
                                            <GradientStop Color="#00FFFF" Offset="0.50"/>
                                            <GradientStop Color="#0000FF" Offset="0.67"/>
                                            <GradientStop Color="#FF00FF" Offset="0.83"/>
                                            <GradientStop Color="#FF0000" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Draggable Hue Thumb -->
                                <Canvas x:Name="HueCanvas" IsHitTestVisible="False">
                                    <Border x:Name="HueThumb" Width="8" Height="18" Margin="-4,-2,0,0"
                                            CornerRadius="4" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.7" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Bottom Controls: Swatch, Hex Input, Apply Button -->
                        <Grid Width="220" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live Color Preview Swatch -->
                            <Border Grid.Column="0" x:Name="CustomColorPreview" Width="30" Height="30" CornerRadius="6" Background="#FF5500" BorderBrush="#FFFFFF" BorderThickness="2" Margin="0,0,8,0"/>

                            <!-- Hex Input Box -->
                            <TextBox Grid.Column="1" x:Name="TxtCustomHex" Text="#FF5500" Background="{DynamicResource MenuInputBgBrush}" BorderBrush="{DynamicResource MenuInputBorderBrush}" BorderThickness="1" Foreground="{DynamicResource MenuInputTextBrush}" FontFamily="{DynamicResource MenuLabelFont}" FontSize="13" FontWeight="Bold" Padding="6,4" VerticalContentAlignment="Center" CaretBrush="{DynamicResource MenuAccentBrush}" Cursor="IBeam" Margin="0,0,8,0" TextChanged="TxtCustomHex_TextChanged"/>

                            <!-- Apply Button -->
                            <Button x:Name="BtnApplyCustomColor" Grid.Column="2" Style="{DynamicResource PopupPrimaryButtonStyle}" Height="30" Content="Apply" Click="BtnApplyCustomColor_Click" FontSize="12" FontWeight="Bold" Padding="12,0"/>
                        </Grid>
                        </StackPanel>

                        <!-- TRANSPARENCY & DIMMING SECTION -->
                        <Separator Background="{DynamicResource MenuSeparatorBrush}" Margin="0,2,0,10"/>

                        <TextBlock x:Name="TxtTransparencyDimming" Text="Transparency &amp; Dimming" FontSize="{DynamicResource MenuHeaderFontSize}" FontFamily="{DynamicResource MenuHeaderFont}" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" Margin="2,0,0,8"/>

                        <!-- Note Solid Opacity Row -->
                        <Grid Margin="2,0,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtNoteOpacityHeader" Text="Note Opacity" FontSize="{DynamicResource MenuLabelFontSize}" FontFamily="{DynamicResource MenuLabelFont}" FontWeight="SemiBold" Foreground="{DynamicResource MenuLabelBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtActiveOpacityPercent" Grid.Column="1" Text="100%" FontSize="{DynamicResource MenuLabelFontSize}" FontFamily="{DynamicResource MenuLabelFont}" FontWeight="Bold" Foreground="{DynamicResource MenuAccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="SliderActiveOpacity" Style="{DynamicResource PopupSliderStyle}" Minimum="30" Maximum="100" Value="100" SmallChange="5" LargeChange="10" Margin="2,0,2,10" ValueChanged="SliderActiveOpacity_ValueChanged"/>

                        <!-- Unfocused Dimming Toggle -->
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtDimWhenUnfocusedHeader" Text="Dim When Unfocused" FontSize="{DynamicResource MenuLabelFontSize}" FontFamily="{DynamicResource MenuLabelFont}" FontWeight="SemiBold" Foreground="{DynamicResource MenuLabelBrush}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkUnfocusedDim" Grid.Column="1" Style="{DynamicResource PopupSwitchStyle}" IsChecked="True" Click="ChkUnfocusedDim_Click"/>
                        </Grid>

                        <!-- Unfocused Opacity Factor Slider -->
                        <StackPanel x:Name="UnfocusedOpacityControlsPanel" Margin="2,0,2,2">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtUnfocusedOpacityHeader" Text="Unfocused Opacity" FontSize="{DynamicResource MenuLabelFontSize}" FontFamily="{DynamicResource MenuLabelFont}" FontWeight="SemiBold" Foreground="{DynamicResource MenuLabelMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUnfocusedOpacityPercent" Grid.Column="1" Text="55%" FontSize="{DynamicResource MenuLabelFontSize}" FontFamily="{DynamicResource MenuLabelFont}" FontWeight="Bold" Foreground="{DynamicResource MenuAccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="SliderUnfocusedOpacity" Style="{DynamicResource PopupSliderStyle}" Minimum="15" Maximum="90" Value="55" SmallChange="5" LargeChange="10" ValueChanged="SliderUnfocusedOpacity_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                    </DockPanel>
                </skins:CutBorder>
                <!-- diamond tips on the frame (skins with MenuOrnamentVisibility = Visible) -->
                <Rectangle Width="7" Height="7" Fill="{DynamicResource MenuOrnamentBrush}" Visibility="{DynamicResource MenuOrnamentVisibility}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3.5,0,0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="7" Height="7" Fill="{DynamicResource MenuOrnamentBrush}" Visibility="{DynamicResource MenuOrnamentVisibility}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3.5" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                </Rectangle>
                </Grid>
            </Popup>

        </Grid>
    </Border>

    <!-- 8-Way Multi-Directional Window Resize Hit-Zones (Top, Bottom, Left, Right, 4 Corners) -->
    <Grid x:Name="ResizeOverlayGrid" IsHitTestVisible="True">
        <!-- 4 Edge Rectangles -->
        <Rectangle x:Name="ResizeEdgeTop" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="14,0,14,0" Fill="#01000000" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeEdgeBottom" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="14,0,14,0" Fill="#01000000" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeEdgeLeft" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14,0,14" Fill="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeEdgeRight" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,14,0,14" Fill="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>

        <!-- 4 Corner Rectangles -->
        <Rectangle x:Name="ResizeCornerTopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#01000000" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeCornerTopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#01000000" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeCornerBottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#01000000" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
        <Rectangle x:Name="ResizeCornerBottomRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#01000000" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown"/>
    </Grid>
</Grid>
</Window>

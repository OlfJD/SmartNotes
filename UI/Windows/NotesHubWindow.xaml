<Window x:Class="SmartNotes.UI.Windows.NotesHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        mc:Ignorable="d"
        Title="SmartNotes Hub"
        Icon="../../Assets/app.ico"
        Height="740" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- Outer Clean 5px Border Frame (Zero black outer pixels, zero inner seams) -->
    <Border CornerRadius="16" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="5">
        <Grid Margin="-1">
            <Grid.RowDefinitions>
                <!-- 1. Header Bar -->
                <RowDefinition Height="64"/>
                <!-- 2. Main Hub Body -->
                <RowDefinition Height="*"/>
                <!-- 3. Status Bar -->
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- 1. TITLE BAR -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,3" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#261E10" BorderBrush="#5A3E16" BorderThickness="2" Margin="0,0,12,0">
                            <controls:LucideIcon IconKey="file-text" Size="20" StrokeThickness="2.6" Foreground="{StaticResource NeonAmberGlowBrush}"/>
                        </Border>
                        <TextBlock Text="SmartNotes" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#1C271E" BorderBrush="#1D5443" BorderThickness="1.5" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DESKTOP PINNED" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldGlowBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="SettingsBtn_Click" ToolTip="Settings &amp; Hotkeys" Margin="0,0,4,0">
                            <controls:LucideIcon IconKey="settings" Size="20" StrokeThickness="2.6" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="MinimizeBtn_Click" ToolTip="Minimize to Tray" Margin="0,0,4,0">
                            <controls:LucideIcon IconKey="minus" Size="19" StrokeThickness="2.8" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="CloseBtn_Click" ToolTip="Close Hub (Notes remain on Desktop)">
                            <controls:LucideIcon IconKey="x" Size="19" StrokeThickness="2.8" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN HUB BODY -->
            <Grid Grid.Row="1" Margin="22,16,22,12">
                <Grid.RowDefinitions>
                    <!-- Search & Filter Controls -->
                    <RowDefinition Height="Auto"/>
                    <!-- Notes Grid / List View -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SECTION 1: SEARCH & ACTIONS BAR (3px Thick Border) -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Search input -->
                            <ColumnDefinition Width="300"/>
                            <!-- Filter Tabs -->
                            <ColumnDefinition Width="*"/>
                            <!-- Action Buttons -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBox}" Padding="36,8,10,8" TextChanged="TxtSearch_TextChanged"/>
                            <controls:LucideIcon IconKey="search" Size="17" StrokeThickness="2.4" Foreground="#7888A4" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="Search notes or tasks..." Foreground="#64748B" FontSize="14.5" IsHitTestVisible="False" VerticalAlignment="Center" Margin="38,0,0,0"/>
                        </Grid>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <RadioButton x:Name="TabAll" Content="All Notes" GroupName="HubFilter" IsChecked="True" Checked="FilterTab_Changed" Style="{x:Null}" Foreground="#F8FAFC" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,16,0" Cursor="Hand"/>
                            <RadioButton x:Name="TabChecklists" Content="Checklists" GroupName="HubFilter" Checked="FilterTab_Changed" Style="{x:Null}" Foreground="#A8B5CD" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,16,0" Cursor="Hand"/>
                            <RadioButton x:Name="TabTrash" Content="Trash Bin" GroupName="HubFilter" Checked="FilterTab_Changed" Style="{x:Null}" Foreground="#A8B5CD" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,16,0" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GlowButton}" Padding="14,8" Click="BtnArrange_Click" ToolTip="Tile and arrange notes neatly on desktop" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LucideIcon IconKey="layers" Size="16" StrokeThickness="2.6" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Arrange Desktop" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryAmberButton}" Padding="18,8" Click="BtnNewNote_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LucideIcon IconKey="plus" Size="16" StrokeThickness="2.8" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                    <TextBlock Text="New Note" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SECTION 2: NOTES LISTING CARDS (3px Thick Border) -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2.5" CornerRadius="14" Padding="14">
                    <Grid>
                        <!-- Empty State Notice -->
                        <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <controls:LucideIcon IconKey="file-text" Size="52" StrokeThickness="2" Foreground="#3B4C6F" Margin="0,0,0,14"/>
                            <TextBlock Text="No notes found" FontSize="18" FontWeight="Bold" Foreground="#A8B5CD" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click '+ New Note' or press Win+Alt+N to create your first sticky note" FontSize="14.5" Foreground="#64748B" Margin="0,6,0,18" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource PrimaryAmberButton}" Content="+ Create Sticky Note" HorizontalAlignment="Center" Click="BtnNewNote_Click"/>
                        </StackPanel>

                        <!-- Notes Scrollable List -->
                        <ScrollViewer x:Name="NotesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="NotesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Note Preview Card with 2.5px thick border -->
                                        <Border Background="#131826" BorderBrush="#25324D" BorderThickness="2.5" CornerRadius="12" Margin="0,0,0,12" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Color Tag Pillar -->
                                                    <ColumnDefinition Width="6"/>
                                                    <!-- Note Info -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Action Buttons -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Color Stripe -->
                                                <Border Grid.Column="0" CornerRadius="3" Background="{Binding ColorKey, Converter={StaticResource ColorToBrushConv}}" Margin="0,0,16,0" Width="6"/>

                                                <!-- Content Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <!-- Title & Badges Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Title, TargetNullValue='(Untitled Note)', FallbackValue='(Untitled Note)'}" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        
                                                        <Border Background="#1A2438" BorderBrush="#33466C" BorderThickness="1.5" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PinMode}" FontSize="11.5" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                                        </Border>

                                                        <Border Background="#201C12" BorderBrush="#5A4216" BorderThickness="1.5" CornerRadius="6" Padding="8,2">
                                                            <TextBlock Text="{Binding ColorKey}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource NeonAmberGlowBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Snippet Preview -->
                                                    <TextBlock Text="{Binding SnippetPreview}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" FontSize="14.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                                    <!-- Footer details -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Updated: " FontSize="12.5" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding ModifiedAt, StringFormat='{}{0:g}'}" FontSize="12.5" Foreground="#7888A4" Margin="0,0,20,0"/>
                                                        <TextBlock Text="{Binding X, StringFormat='{}Pos: {0:F0}, '}" FontSize="12.5" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Y, StringFormat='{}{0:F0}'}" FontSize="12.5" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions on the right -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GlowButton}" Padding="12,7" Margin="0,0,8,0" Click="BtnLocateNote_Click" ToolTip="Bring note forward and focus on desktop">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:LucideIcon IconKey="external-link" Size="14" StrokeThickness="2.6" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Locate" FontSize="13.5"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="BtnDuplicateNote_Click" ToolTip="Duplicate Note" Margin="0,0,6,0">
                                                        <controls:LucideIcon IconKey="copy" Size="16" StrokeThickness="2.4" Foreground="#A8B5CD"/>
                                                    </Button>

                                                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="BtnCardDelete_Click" ToolTip="Delete / Move to Trash">
                                                        <controls:LucideIcon IconKey="trash-2" Size="16" StrokeThickness="2.4" Foreground="#EF4444"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. STATUS BAR (3px Top Border) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,3,0,0" CornerRadius="0,0,12,12">
                <Grid Margin="22,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusActiveCount" Text="Active Sticky Notes: 2" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NeonAmberGlowBrush}" Margin="0,0,22,0"/>
                        <TextBlock Text="Shortcut: Win+Alt+N to create note anywhere" FontSize="13.5" Foreground="#7888A4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="Export All (.json)" Foreground="#A8B5CD" FontSize="13.5" Click="BtnExportAll_Click" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource IconButton}" Content="Import (.json)" Foreground="#A8B5CD" FontSize="13.5" Click="BtnImport_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

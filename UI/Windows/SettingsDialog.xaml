<Window x:Class="SmartNotes.UI.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        mc:Ignorable="d"
        Title="SmartNotes Settings"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <!-- Outer Clean 5px Border Frame (Zero black outer pixels, zero inner seams) -->
    <Border CornerRadius="16" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="5">
        <Grid Margin="-1">
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="60"/>
                <!-- Settings Content -->
                <RowDefinition Height="*"/>
                <!-- Footer Buttons -->
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,3" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon IconKey="settings" Size="22" StrokeThickness="2.6" Foreground="{StaticResource NeonAmberGlowBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="Settings &amp; Preferences" FontSize="19.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="36" Height="36" Click="CloseBtn_Click">
                        <controls:LucideIcon IconKey="x" Size="19" StrokeThickness="2.8" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Margin="22,18,22,14" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Group 1: Desktop & Startup -->
                    <TextBlock Text="DESKTOP &amp; SYSTEM" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource NeonAmberGlowBrush}" Margin="0,0,0,10"/>
                    
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2.5" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                        <StackPanel>
                            <!-- Autostart Toggle -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Launch with Windows Startup" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Automatically load your desktop sticky notes on system boot" FontSize="13.5" Foreground="#7888A4" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkStartup" Grid.Column="1" Style="{StaticResource ModernSwitch}" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator/>

                            <!-- Keep Behind Windows (Desktop Sticking) -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Desktop Sticking (Below All Applications)" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Keep sticky notes fixed on wallpaper underneath open apps &amp; games" FontSize="13.5" Foreground="#7888A4" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkDesktopStuck" Grid.Column="1" Style="{StaticResource ModernSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Hotkeys -->
                    <TextBlock Text="GLOBAL SHORTCUTS" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,0,10"/>
                    
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2.5" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Global Hotkeys" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Use system-wide keyboard shortcuts anywhere in Windows" FontSize="13.5" Foreground="#7888A4" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkHotkeys" Grid.Column="1" Style="{StaticResource ModernSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#101522" CornerRadius="8" Padding="12,10" BorderBrush="#202A3D" BorderThickness="1.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Create New Sticky Note" FontSize="14" Foreground="#A8B5CD" Margin="0,4"/>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#1E273C" CornerRadius="5" Padding="8,3" Margin="0,4">
                                        <TextBlock Text="Win + Alt + N" FontSize="12.5" FontWeight="Bold" Foreground="#93C5FD"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Open Notes Hub / Manager" FontSize="14" Foreground="#A8B5CD" Margin="0,4"/>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#1E273C" CornerRadius="5" Padding="8,3" Margin="0,4">
                                        <TextBlock Text="Win + Alt + H" FontSize="12.5" FontWeight="Bold" Foreground="#93C5FD"/>
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Show / Hide All Desktop Notes" FontSize="14" Foreground="#A8B5CD" Margin="0,4"/>
                                    <Border Grid.Row="2" Grid.Column="1" Background="#1E273C" CornerRadius="5" Padding="8,3" Margin="0,4">
                                        <TextBlock Text="Win + Alt + D" FontSize="12.5" FontWeight="Bold" Foreground="#93C5FD"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Group 3: Default Style -->
                    <TextBlock Text="DEFAULT NOTE APPEARANCE" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldGlowBrush}" Margin="0,0,0,10"/>
                    
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2.5" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Theme Color" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultColor" Grid.Row="0" Grid.Column="1" Height="38" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Default Font Size" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbDefaultFontSize" Grid.Row="1" Grid.Column="1" Height="38"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,3,0,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Button Style="{StaticResource GlowButton}" Content="Cancel" Padding="18,8" Margin="0,0,12,0" Click="CloseBtn_Click"/>
                    <Button Style="{StaticResource PrimaryAmberButton}" Content="Save Settings" Padding="22,8" Click="SaveBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

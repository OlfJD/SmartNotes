<Window x:Class="SmartNotes.UI.Windows.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        Title="SmartNotes"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="12">
        <Border Background="#141926" CornerRadius="{StaticResource RadiusPanel}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border Background="#141926" BorderBrush="#334368" BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (draggable) -->
                <Border Grid.Row="0" Background="#10141F" CornerRadius="9,9,0,0" BorderBrush="#1E273C" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:LucideIcon Grid.Column="0" IconKey="bell" Size="14" StrokeThickness="2.2" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="Remind Me" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="#8898B4" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Padding="0" Click="BtnCancel_Click">
                            <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.2" Foreground="#8898B4"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Day, time, repeat -->
                <Grid Grid.Row="1" Margin="20,18,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtDayLabel" Grid.Row="0" Text="Day" Foreground="#94A3B8" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                    <ComboBox x:Name="CmbDay" Grid.Row="0" Grid.Column="1" Height="32" Margin="0,0,0,10" SelectionChanged="Inputs_Changed"/>

                    <TextBlock x:Name="TxtTimeLabel" Grid.Row="1" Text="Time" Foreground="#94A3B8" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbHour" Width="74" Height="32" SelectionChanged="Inputs_Changed"/>
                        <TextBlock Text=":" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                        <ComboBox x:Name="CmbMinute" Width="74" Height="32" SelectionChanged="Inputs_Changed"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtRepeatLabel" Grid.Row="2" Text="Repeat" Foreground="#94A3B8" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                    <ComboBox x:Name="CmbRepeat" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,0,10" SelectionChanged="Inputs_Changed"/>

                    <!-- "Reminds you Fri 28 Nov, 09:00" -->
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <controls:LucideIcon IconKey="alarm-clock" Size="14" StrokeThickness="2.2" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtSummary" Text="" Foreground="#CBD5E1" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Buttons -->
                <Border Grid.Row="2" Background="#0F131D" CornerRadius="0,0,9,9" BorderBrush="#1E273C" BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid>
                        <Button x:Name="BtnRemove" HorizontalAlignment="Left" Style="{StaticResource IconButton}" Height="34" Padding="10,0" Click="BtnRemove_Click" Visibility="Collapsed">
                            <TextBlock x:Name="TxtRemove" Text="Remove reminder" Foreground="#FB7185" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancel" Click="BtnCancel_Click" Content="Cancel" MinWidth="84" Height="34" Margin="0,0,10,0" Foreground="#CBD5E1" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Bd" Background="#1A2234" BorderBrush="#2D3B59" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#25324E"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C618F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnSet" Click="BtnSet_Click" Content="Set Reminder" MinWidth="110" Height="34" Style="{StaticResource PrimaryButton}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

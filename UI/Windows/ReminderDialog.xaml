<Window x:Class="SmartNotes.UI.Windows.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        xmlns:skins="clr-namespace:SmartNotes.UI.Skins"
        Title="SmartNotes"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <!-- In the note's theme: every value is a Menu* token (SkinMenus.ApplyToPanel with the note's skin). -->
    <Grid Margin="12">
        <skins:CutBorder Background="{DynamicResource MenuShadowBrush}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}">
            <skins:CutBorder.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
            </skins:CutBorder.Effect>
        </skins:CutBorder>

        <skins:CutBorder Background="{DynamicResource MenuPanelBgBrush}" BorderBrush="{DynamicResource MenuPanelBorderBrush}" BorderThickness="{DynamicResource MenuPanelBorderThickness}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}" RenderOptions.ClearTypeHint="Enabled">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="{DynamicResource MenuTopStripHeight}" Background="{DynamicResource MenuTopStripBrush}" CornerRadius="{DynamicResource MenuTopStripRadius}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header (draggable) -->
                    <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Margin="10,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Grid.Column="0" IconKey="bell" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource MenuAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="Remind Me" FontFamily="{DynamicResource MenuHeaderFont}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Padding="0" Click="BtnCancel_Click">
                                <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.2" Foreground="{DynamicResource MenuLabelMutedBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Day, time, repeat -->
                    <Grid Grid.Row="1" Margin="20,18,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtDayLabel" Grid.Row="0" Text="Day" FontFamily="{DynamicResource MenuLabelFont}" FontSize="{DynamicResource MenuLabelFontSize}" Foreground="{DynamicResource MenuLabelMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                        <ComboBox x:Name="CmbDay" Grid.Row="0" Grid.Column="1" Height="32" Margin="0,0,0,10" Style="{DynamicResource PopupComboBoxStyle}" SelectionChanged="Inputs_Changed"/>

                        <TextBlock x:Name="TxtTimeLabel" Grid.Row="1" Text="Time" FontFamily="{DynamicResource MenuLabelFont}" FontSize="{DynamicResource MenuLabelFontSize}" Foreground="{DynamicResource MenuLabelMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="CmbHour" Width="74" Height="32" Style="{DynamicResource PopupComboBoxStyle}" SelectionChanged="Inputs_Changed"/>
                            <TextBlock Text=":" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MenuLabelMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                            <ComboBox x:Name="CmbMinute" Width="74" Height="32" Style="{DynamicResource PopupComboBoxStyle}" SelectionChanged="Inputs_Changed"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtRepeatLabel" Grid.Row="2" Text="Repeat" FontFamily="{DynamicResource MenuLabelFont}" FontSize="{DynamicResource MenuLabelFontSize}" Foreground="{DynamicResource MenuLabelMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,10"/>
                        <ComboBox x:Name="CmbRepeat" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,0,10" Style="{DynamicResource PopupComboBoxStyle}" SelectionChanged="Inputs_Changed"/>

                        <!-- "Reminds you Fri 28 Nov, 09:00" -->
                        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <controls:LucideIcon DockPanel.Dock="Left" IconKey="alarm-clock" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource MenuAccentBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock x:Name="TxtSummary" Text="" FontFamily="{DynamicResource MenuLabelFont}" FontSize="{DynamicResource MenuLabelFontSize}" Foreground="{DynamicResource MenuLabelBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>

                    <!-- Buttons -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,0" Margin="10,0" Padding="6,12,6,14">
                        <Grid>
                            <Button x:Name="BtnRemove" HorizontalAlignment="Left" Style="{StaticResource IconButton}" Height="34" Padding="10,0" Click="BtnRemove_Click" Visibility="Collapsed">
                                <TextBlock x:Name="TxtRemove" Text="Remove reminder" FontFamily="{DynamicResource MenuChoiceFont}" Foreground="{DynamicResource MenuDangerBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancel" Click="BtnCancel_Click" Content="Cancel" MinWidth="84" Height="34" Padding="14,0" Margin="0,0,10,0" FontSize="13.5" FontWeight="SemiBold" Style="{DynamicResource PopupChoiceButtonStyle}"/>
                                <Button x:Name="BtnSet" Click="BtnSet_Click" Content="Set Reminder" MinWidth="110" Height="34" Padding="14,0" FontSize="13.5" FontWeight="Bold" Style="{DynamicResource PopupPrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>
        </skins:CutBorder>
    </Grid>
</Window>

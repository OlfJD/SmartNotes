<Window x:Class="SmartNotes.UI.Windows.ProgramPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartNotes.UI.Controls"
        xmlns:skins="clr-namespace:SmartNotes.UI.Skins"
        Title="SmartNotes"
        Width="440"
        Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- "Show Only With > Choose a Program…": search the programs that are open or installed, or browse for one.
         In the note's theme (Menu* tokens, SkinMenus.ApplyToPanel). -->
    <Grid Margin="12">
        <skins:CutBorder Background="{DynamicResource MenuShadowBrush}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}">
            <skins:CutBorder.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
            </skins:CutBorder.Effect>
        </skins:CutBorder>
        <skins:CutBorder Background="{DynamicResource MenuPanelBgBrush}" BorderBrush="{DynamicResource MenuPanelBorderBrush}" BorderThickness="{DynamicResource MenuPanelBorderThickness}" CornerRadius="{DynamicResource MenuPanelRadius}" Cut="{DynamicResource MenuPanelCut}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="{DynamicResource MenuTopStripHeight}" Background="{DynamicResource MenuTopStripBrush}" CornerRadius="{DynamicResource MenuTopStripRadius}"/>
                <!-- Header -->
                <Border DockPanel.Dock="Top" Height="40" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,0,0,1" Margin="10,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                    <Grid Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:LucideIcon IconKey="app-window" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource MenuAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="Show Only With" FontFamily="{DynamicResource MenuHeaderFont}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource MenuHeaderBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Padding="0" Click="BtnCancel_Click">
                            <controls:LucideIcon IconKey="x" Size="13" StrokeThickness="2.2" Foreground="{DynamicResource MenuLabelMutedBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Buttons -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MenuSeparatorBrush}" BorderThickness="0,1,0,0" Margin="10,0" Padding="6,12,6,14">
                    <DockPanel>
                        <Button x:Name="BtnBrowse" DockPanel.Dock="Left" Click="BtnBrowse_Click" Height="34" Padding="12,0" FontSize="13.5" FontWeight="SemiBold" Style="{DynamicResource PopupChoiceButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="folder" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource MenuAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBrowse" Text="Browse…" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancel" Click="BtnCancel_Click" Content="Cancel" MinWidth="84" Height="34" Padding="14,0" Margin="0,0,10,0" FontSize="13.5" FontWeight="SemiBold" Style="{DynamicResource PopupChoiceButtonStyle}"/>
                            <Button x:Name="BtnChoose" Click="BtnChoose_Click" Content="Link" MinWidth="92" Height="34" Padding="14,0" FontSize="13.5" FontWeight="Bold" Style="{DynamicResource PopupPrimaryButtonStyle}" IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search and list -->
                <Grid Margin="16,14,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="TxtSearch" Height="34" Padding="30,0,8,0" Style="{DynamicResource PopupTextBoxStyle}" TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                        <controls:LucideIcon IconKey="search" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource MenuLabelMutedBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="TxtSearchHint" Text="Search programs" FontFamily="{DynamicResource MenuLabelFont}" FontSize="{DynamicResource MenuLabelFontSize}" Foreground="{DynamicResource MenuLabelMutedBrush}" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox x:Name="ProgramList" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource PopupListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ProgramList_SelectionChanged" MouseDoubleClick="ProgramList_MouseDoubleClick"/>
                    <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" FontFamily="{DynamicResource MenuLabelFont}" FontSize="12" Foreground="{DynamicResource MenuLabelMutedBrush}" Margin="2,6,0,0"/>
                </Grid>
            </DockPanel>
        </skins:CutBorder>
    </Grid>
</Window>
